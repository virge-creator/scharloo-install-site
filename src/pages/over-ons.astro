---
import Layout from '../layouts/Layout.astro';

const values = [
  {
    title: 'Kwaliteit',
    description: 'Wij werken uitsluitend met kwalitatieve materialen van gerenommeerde merken.',
    number: '01'
  },
  {
    title: 'Snelheid',
    description: 'De meeste installaties zijn binnen een dag gereed. Uw voertuig is snel weer inzetbaar.',
    number: '02'
  },
  {
    title: 'Service',
    description: 'Ook na de installatie staan wij voor u klaar. Bij vragen helpen wij u graag verder.',
    number: '03'
  },
];
---

<Layout title="Over ons" description="Leer meer over Scharloo-Install, uw specialist in telematica en voertuiginstallaties.">
  <!-- Hero -->
  <section class="min-h-[60vh] bg-black text-white flex items-end pb-20 relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="max-w-7xl mx-auto px-6 lg:px-8 w-full">
      <p class="text-brand font-medium tracking-widest uppercase mb-4 animate-fade-in-up">Over ons</p>
      <h1 class="heading-xl animate-fade-in-up delay-100" style="opacity: 0;">
        Uw<br />
        <span class="text-gray-500">inbouwpartner</span>
      </h1>
    </div>
  </section>

  <!-- Story Section -->
  <section class="py-24 lg:py-32 bg-gray-950">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <div class="reveal">
          <h2 class="text-4xl md:text-5xl font-bold mb-8">
            Vakmanschap<br />
            <span class="text-gray-500">& precisie</span>
          </h2>
        </div>
        <div class="reveal lg:pt-4">
          <div class="space-y-6 text-xl text-gray-400 leading-relaxed">
            <p>
              Scharloo-Install is gespecialiseerd in de professionele inbouw van 
              telematica en voertuigelektronica. Van ritregistratiesystemen tot 
              dashcams met live verbinding, van tachografen tot startblokkeringen.
            </p>
            <p>
              Onze kracht zit in precisie en oog voor detail. Elke installatie 
              wordt netjes en onzichtbaar weggewerkt, zonder losse kabels of 
              zichtbare aanpassingen.
            </p>
            <p>
              Wij werken voor zowel particulieren als bedrijven met wagenparken. 
              Of het nu gaat om één voertuig of een complete vloot: bij ons 
              bent u aan het juiste adres.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Big Statement -->
  <section class="py-24 lg:py-32 bg-black">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center reveal">
      <p class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight max-w-4xl mx-auto">
        "Elke installatie wordt netjes en 
        <span class="text-brand">onzichtbaar</span> weggewerkt"
      </p>
    </div>
  </section>

  <!-- Values -->
  <section class="py-24 lg:py-32 bg-gray-950">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="mb-16 reveal">
        <p class="text-brand font-medium tracking-widest uppercase mb-4">Onze waarden</p>
        <h2 class="text-4xl md:text-5xl font-bold">
          Waar wij<br />
          <span class="text-gray-500">voor staan</span>
        </h2>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-0 border-t border-l border-gray-800">
        {values.map(value => (
          <div class="p-8 lg:p-12 border-r border-b border-gray-800 reveal">
            <span class="text-6xl font-black text-gray-900">{value.number}</span>
            <h3 class="text-2xl font-bold -mt-6 mb-4">{value.title}</h3>
            <p class="text-gray-400 text-lg">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="py-24 bg-black">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 text-center reveal">
        <div>
          <p class="text-6xl md:text-7xl font-black text-brand">500+</p>
          <p class="text-gray-500 mt-2 uppercase tracking-widest">Installaties</p>
        </div>
        <div>
          <p class="text-6xl md:text-7xl font-black text-brand">3000+</p>
          <p class="text-gray-500 mt-2 uppercase tracking-widest">Koffie gedronken</p>
        </div>
        <div>
          <p class="text-6xl md:text-7xl font-black text-brand">100%</p>
          <p class="text-gray-500 mt-2 uppercase tracking-widest">Vakmanschap</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-24 md:py-32 bg-black overflow-hidden border-t border-white/10 reveal">
    <div class="absolute -top-40 right-[-10%] w-[45rem] h-[45rem] bg-brand/15 rounded-full blur-3xl" aria-hidden="true"></div>
    <div class="absolute -bottom-40 left-[-10%] w-[45rem] h-[45rem] bg-brand/10 rounded-full blur-3xl" aria-hidden="true"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-6 lg:px-8 text-center">
      <p class="text-brand font-medium tracking-widest uppercase mb-4">Over ons</p>
      <h2 class="heading-lg mb-6">Laten we<br />samenwerken</h2>
      <p class="text-lg text-gray-300 mb-10 max-w-2xl mx-auto">Vertel ons uw wensen, dan denken wij met u mee en maken een passend voorstel.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-10">
        <a href="/contact/#formulier" class="motion-button group inline-flex items-center justify-center gap-3 bg-brand text-white rounded-full px-9 py-4 text-lg font-bold hover:bg-white hover:text-black transition-all duration-300">Contact opnemen <span class="group-hover:translate-x-1 transition-transform duration-300">→</span></a>
        <a href="/diensten/" class="inline-flex items-center justify-center gap-3 rounded-full border border-white/20 text-white px-9 py-4 text-lg font-semibold hover:border-brand hover:text-brand transition-colors">Bekijk onze diensten</a>
      </div>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="tel:+31182796197" class="inline-flex items-center gap-2.5 rounded-full bg-white/5 ring-1 ring-white/10 px-5 py-3 text-gray-200 hover:ring-brand hover:text-white transition-all">
          <svg class="w-4 h-4 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
          (0182) 79 61 97
        </a>
        <a href="mailto:info@scharloo-install.nl" class="inline-flex items-center gap-2.5 rounded-full bg-white/5 ring-1 ring-white/10 px-5 py-3 text-gray-200 hover:ring-brand hover:text-white transition-all">
          <svg class="w-4 h-4 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
          info@scharloo-install.nl
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  const reveals = document.querySelectorAll('.reveal');
  
  const revealOnScroll = () => {
    reveals.forEach(el => {
      const top = el.getBoundingClientRect().top;
      if (top < window.innerHeight - 100) {
        el.classList.add('active');
      }
    });
  };
  
  window.addEventListener('scroll', revealOnScroll);
  revealOnScroll();
</script>
