---
import Layout from '../layouts/Layout.astro';
import { diensten, dienstUrl } from '../data/diensten';

const reasons = [
  'Specialist in installatie van voertuigsystemen',
  'Focus op kwaliteit en klanttevredenheid',
  'Flexibel en snel inzetbaar',
  'Ervaring met diverse systemen en merken',
  'Actief in Nederland en België',
];

// Icoon per dienst (inner-SVG, stroke-stijl).
const dienstIconen: Record<string, string> = {
  'voertuigvolgsystemen': '<path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0Z"/><circle cx="12" cy="10" r="3"/>',
  'gps-startonderbreker': '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><rect x="9.5" y="11" width="5" height="4.5" rx="1"/><path d="M10.2 11V9.6a1.8 1.8 0 0 1 3.6 0V11"/>',
  'dashcams': '<path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2Z"/><circle cx="12" cy="13" r="4"/>',
  'alarmsystemen': '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/>',
  'tachograaf': '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/>',
  'can-bus': '<rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 2v2M15 2v2M9 20v2M15 20v2M2 9h2M2 15h2M20 9h2M20 15h2"/>',
  'driver-id': '<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="M15 9h3M15 13h3M6 15.5c0-1.4 1.4-2 3-2s3 .6 3 2"/>',
  'io-integraties': '<path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/>',
  'temperatuur-monitoring': '<path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0Z"/>',
  'target-blu-eye': '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>',
  'trekhaken': '<circle cx="12" cy="5" r="2"/><path d="M12 7v4l-5 6"/><rect x="3" y="17" width="18" height="4" rx="1"/>',
};
const standaardIcoon = '<circle cx="12" cy="12" r="9"/><path d="m9 12 2 2 4-4"/>';
---

<Layout
  title="Diensten | inbouw voertuigsystemen, dashcams & alarm"
  description="Alle diensten van Scharloo-Install: voertuigvolgsystemen, dashcams, SCM/CCV-alarm, CAN-bus, tachograaf, Driver ID, I/O en temperatuurmonitoring. Klik door voor info en prijzen."
>
  <!-- Hero -->
  <section class="min-h-[60vh] bg-black text-white flex items-end pb-20 relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="max-w-7xl mx-auto px-6 lg:px-8 w-full">
      <p class="text-brand font-medium tracking-widest uppercase mb-4 animate-fade-in-up">Onze diensten</p>
      <h1 class="heading-xl animate-fade-in-up delay-100" style="opacity: 0;">
        Inbouw<br />
        <span class="text-gray-500">voertuigsystemen</span>
      </h1>
      <p class="text-xl text-gray-400 max-w-2xl mt-8 animate-fade-in-up delay-200" style="opacity: 0;">
        Scharloo-Install B.V. is specialist in de installatie van voertuigsystemen. Klik een dienst open voor meer informatie, en bekijk op de dienstpagina de details en prijzen.
      </p>
    </div>
  </section>

  <!-- Diensten als kaarten -->
  <section class="bg-black py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <p class="text-brand font-medium tracking-widest uppercase mb-10 reveal">Overzicht diensten</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5">
        {diensten.map((d, i) => (
          <a
            href={dienstUrl(d)}
            class="group motion-card reveal relative rounded-2xl bg-gray-950 ring-1 ring-white/10 hover:ring-brand p-6 md:p-7 flex flex-col h-full transition-all"
            style={`--item-index:${i}`}
          >
            <div class="flex items-start justify-between mb-5">
              <span class="flex items-center justify-center w-12 h-12 rounded-xl bg-brand/15 text-brand group-hover:bg-brand group-hover:text-white transition-colors duration-300">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={dienstIconen[d.slug] || standaardIcoon}></svg>
              </span>
              <span class="text-2xl text-gray-700 group-hover:text-brand group-hover:translate-x-1 transition-all duration-300">→</span>
            </div>
            <h2 class="text-xl font-bold mb-1 group-hover:text-brand transition-colors">{d.title}</h2>
            <p class="text-brand/80 text-sm font-medium mb-3">{d.subtitle}</p>
            <p class="text-sm text-gray-400 leading-relaxed">{d.kort}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Waarom Scharloo-Install -->
  <section class="py-24 bg-gray-950">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="max-w-3xl reveal">
        <p class="text-brand font-medium tracking-widest uppercase mb-4">Waarom Scharloo-Install</p>
        <ul class="space-y-4">
          {reasons.map((reason) => (
            <li class="flex items-center gap-4 text-xl text-gray-300">
              <span class="text-brand text-2xl">✓</span>
              {reason}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-24 md:py-32 bg-black overflow-hidden border-t border-white/10 reveal">
    <div class="absolute -top-40 right-[-10%] w-[45rem] h-[45rem] bg-brand/15 rounded-full blur-3xl" aria-hidden="true"></div>
    <div class="absolute -bottom-40 left-[-10%] w-[45rem] h-[45rem] bg-brand/10 rounded-full blur-3xl" aria-hidden="true"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-6 lg:px-8 text-center">
        <p class="relative text-brand font-medium tracking-widest uppercase mb-4">Klaar om te starten?</p>
        <h2 class="relative heading-lg mb-6">Op zoek naar een<br /><span class="text-brand">betrouwbare installatiepartner?</span></h2>
        <p class="relative text-lg text-gray-300 mb-10 max-w-2xl mx-auto">Neem contact op voor advies of een vrijblijvende offerte, of reken uw dienst direct online af.</p>
        <div class="relative flex flex-col sm:flex-row gap-4 justify-center mb-10">
          <a href="/contact/#formulier" class="motion-button group inline-flex items-center justify-center gap-3 bg-brand text-white rounded-full px-9 py-4 text-lg font-bold hover:bg-white hover:text-black transition-all duration-300">
            Contact opnemen
            <span class="group-hover:translate-x-1 transition-transform duration-300">→</span>
          </a>
          <a href="/bestellen/" class="inline-flex items-center justify-center gap-3 rounded-full border border-white/20 text-white px-9 py-4 text-lg font-semibold hover:border-brand hover:text-brand transition-colors">
            Direct online bestellen
          </a>
        </div>
        <div class="relative flex flex-col sm:flex-row items-center justify-center gap-3">
          <a href="tel:+31182796197" class="inline-flex items-center gap-2.5 rounded-full bg-white/5 ring-1 ring-white/10 px-5 py-3 text-gray-200 hover:ring-brand hover:text-white transition-all">
            <svg class="w-4 h-4 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
            (0182) 79 61 97
          </a>
          <a href="mailto:info@scharloo-install.nl" class="inline-flex items-center gap-2.5 rounded-full bg-white/5 ring-1 ring-white/10 px-5 py-3 text-gray-200 hover:ring-brand hover:text-white transition-all">
            <svg class="w-4 h-4 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
            info@scharloo-install.nl
          </a>
        </div>
      </div>
  </section>
</Layout>

<script>
  const reveals = document.querySelectorAll('.reveal');

  const revealOnScroll = () => {
    reveals.forEach((el) => {
      const top = el.getBoundingClientRect().top;
      if (top < window.innerHeight - 100) {
        el.classList.add('active');
      }
    });
  };

  window.addEventListener('scroll', revealOnScroll);
  revealOnScroll();
</script>
