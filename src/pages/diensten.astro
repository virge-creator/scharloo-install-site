---
import Layout from '../layouts/Layout.astro';
import { diensten, dienstUrl } from '../data/diensten';

const reasons = [
  'Specialist in installatie van voertuigsystemen',
  'Focus op kwaliteit en klanttevredenheid',
  'Flexibel en snel inzetbaar',
  'Ervaring met diverse systemen en merken',
  'Actief in Nederland en België',
];
---

<Layout
  title="Diensten — inbouw voertuigsystemen, dashcams & alarm"
  description="Alle diensten van Scharloo-Install: voertuigvolgsystemen, dashcams, SCM/CCV-alarm, CAN-bus, tachograaf, Driver ID, I/O en temperatuurmonitoring. Klik door voor info en prijzen."
>
  <!-- Hero -->
  <section class="min-h-[60vh] bg-black text-white flex items-end pb-20">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 w-full">
      <p class="text-brand font-medium tracking-widest uppercase mb-4 animate-fade-in-up">Onze diensten</p>
      <h1 class="heading-xl animate-fade-in-up delay-100" style="opacity: 0;">
        Inbouw<br />
        <span class="text-gray-500">voertuigsystemen</span>
      </h1>
      <p class="text-xl text-gray-400 max-w-2xl mt-8 animate-fade-in-up delay-200" style="opacity: 0;">
        Scharloo-Install B.V. is specialist in de installatie van voertuigsystemen. Klik een dienst open voor meer informatie, en bekijk op de dienstpagina de details en prijzen.
      </p>
    </div>
  </section>

  <!-- Uitklapbaar overzicht -->
  <section class="bg-black py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <p class="text-brand font-medium tracking-widest uppercase mb-10 reveal">Overzicht diensten</p>

      <div class="border-t border-gray-800">
        {diensten.map((d) => (
          <details class="reveal group border-b border-gray-800">
            <summary class="dienst-summary flex items-center justify-between gap-6 py-7 cursor-pointer select-none">
              <div class="flex items-baseline gap-4 md:gap-6">
                <span class="text-brand font-black text-lg md:text-xl tabular-nums">{d.nummer}</span>
                <div>
                  <h2 class="text-2xl md:text-3xl font-bold leading-tight">{d.title}</h2>
                  <p class="text-gray-500 mt-1">{d.subtitle}</p>
                </div>
              </div>
              <span class="dienst-icon text-brand text-3xl font-light leading-none flex-shrink-0 transition-transform duration-300">+</span>
            </summary>

            <div class="pb-10 md:pl-[3.4rem] grid lg:grid-cols-2 gap-8 lg:gap-12">
              <p class="text-lg text-gray-400 leading-relaxed">{d.kort}</p>
              <div>
                <ul class="grid grid-cols-2 gap-3 mb-8">
                  {d.features.map((f) => (
                    <li class="flex items-center gap-3 text-gray-300 text-sm">
                      <span class="w-2 h-2 bg-brand flex-shrink-0"></span>
                      {f}
                    </li>
                  ))}
                </ul>
                <a
                  href={dienstUrl(d)}
                  class="inline-flex items-center gap-3 bg-brand text-white rounded-full px-6 py-3 font-semibold hover:bg-white hover:text-black transition-all duration-300"
                >
                  {d.slug === 'alarmsystemen' ? 'Bekijk alarmsystemen & prijzen' : 'Bekijk dienst & prijzen'}
                  <span>→</span>
                </a>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Waarom Scharloo-Install -->
  <section class="py-24 bg-gray-950">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="max-w-3xl reveal">
        <p class="text-brand font-medium tracking-widest uppercase mb-4">Waarom Scharloo-Install</p>
        <ul class="space-y-4">
          {reasons.map((reason) => (
            <li class="flex items-center gap-4 text-xl text-gray-300">
              <span class="text-brand text-2xl">✓</span>
              {reason}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-32 bg-brand text-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center reveal">
      <h2 class="heading-lg mb-8">
        Op zoek naar een<br />betrouwbare installatiepartner?
      </h2>
      <p class="text-xl text-white/80 mb-12 max-w-xl mx-auto">
        Neem contact op of stel uw vraag direct.
      </p>
      <a
        href="/contact/"
        class="group inline-flex items-center gap-3 bg-white text-brand rounded-full px-10 py-5 text-xl font-bold hover:bg-black hover:text-white transition-all duration-300"
      >
        Contact opnemen
        <span class="group-hover:translate-x-2 transition-transform duration-300">→</span>
      </a>
      <div class="mt-12 text-white/80">
        <p class="text-lg"><a href="tel:+31182796197" class="hover:text-white transition-colors">📞 (0182) 79 61 97</a></p>
        <p class="text-lg"><a href="mailto:info@scharloo-install.nl" class="hover:text-white transition-colors">✉ info@scharloo-install.nl</a></p>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Verberg het standaard uitklap-driehoekje van <details> */
  .dienst-summary {
    list-style: none;
  }
  .dienst-summary::-webkit-details-marker {
    display: none;
  }
  /* + wordt × wanneer de dienst open staat */
  details[open] .dienst-icon {
    transform: rotate(45deg);
  }
</style>

<script>
  const reveals = document.querySelectorAll('.reveal');

  const revealOnScroll = () => {
    reveals.forEach((el) => {
      const top = el.getBoundingClientRect().top;
      if (top < window.innerHeight - 100) {
        el.classList.add('active');
      }
    });
  };

  window.addEventListener('scroll', revealOnScroll);
  revealOnScroll();
</script>
