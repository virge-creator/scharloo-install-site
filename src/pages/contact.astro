---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact" description="Neem contact op met Scharloo-Install voor een vrijblijvende offerte.">
  <!-- Hero -->
  <section class="min-h-[60vh] bg-black text-white flex items-end pb-20 relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 w-full">
      <p class="text-brand font-medium tracking-widest uppercase mb-4 animate-fade-in-up">Contact</p>
      <h1 class="heading-xl animate-fade-in-up delay-100" style="opacity: 0;">
        Neem<br />
        <span class="text-gray-500">contact op</span>
      </h1>
      <p class="text-xl text-gray-400 max-w-2xl mt-8 animate-fade-in-up delay-200">Stel uw vraag of vraag vrijblijvend een offerte aan. Met het merk, model en bouwjaar van uw voertuig kunnen we gerichter met u meedenken.</p>
      <div class="mt-7 flex flex-col sm:flex-row gap-4 animate-fade-in-up delay-300">
        <a href="#formulier" class="inline-flex items-center justify-center rounded-full bg-brand px-7 py-4 font-semibold text-white transition-all duration-300 hover:bg-white hover:text-black">Stuur een aanvraag <span class="ml-2">↓</span></a>
        <a href="tel:+31182796197" class="inline-flex items-center justify-center rounded-full border border-gray-700 px-7 py-4 font-semibold text-white transition-colors hover:border-brand hover:text-brand">Bel (0182) 79 61 97</a>
      </div>
    </div>
  </section>

  <!-- Intro Section -->
  <section class="py-20 bg-black border-t border-gray-800">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="max-w-4xl reveal">
        <p class="text-xl md:text-2xl text-gray-300 leading-relaxed">
          Bij <span class="text-white font-semibold">Scharloo-Install B.V.</span> kunt u terecht voor professionele inbouw van voertuigsystemen. Vertel ons wat u zoekt en voor welk voertuig; we denken met u mee over de passende oplossing.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="py-24 lg:py-32 bg-gray-950">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24">
        <!-- Left: Contact Info -->
        <div class="reveal">
          <div class="space-y-12">
            <div>
              <p class="text-gray-500 uppercase tracking-widest text-sm mb-3">Telefoon</p>
              <a href="tel:+31182796197" class="text-3xl md:text-4xl font-bold hover:text-brand transition-colors">
                0182 796 197
              </a>
            </div>
            
            <div>
              <p class="text-gray-500 uppercase tracking-widest text-sm mb-3">E-mail</p>
              <a href="mailto:info@scharloo-install.nl" class="text-xl md:text-3xl break-all font-bold hover:text-brand transition-colors">
                info@scharloo-install.nl
              </a>
            </div>
            
            <div class="pt-8">
              <p class="text-gray-500 uppercase tracking-widest text-sm mb-3">Openingstijden</p>
              <div class="space-y-2 text-lg text-gray-300">
                <p>Ma – Vr: <span class="font-semibold text-white">08:00 - 17:00</span></p>
                <p>Za: <span class="font-semibold text-white">Op afspraak</span></p>
                <p>Zo: <span class="text-gray-500">Gesloten</span></p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Contact Form -->
        <div class="reveal">
          <form id="formulier" class="space-y-7 scroll-mt-28 rounded-2xl border border-gray-800 bg-black/40 p-6 md:p-9" name="contact" method="POST" action="https://formspree.io/f/mykbkjjw">
            <input type="hidden" name="_subject" value="Nieuw bericht via Scharloo-Install.nl" />
            <input type="hidden" name="_source" value="scharloo-install.nl" />
            <div>
              <h2 class="text-2xl md:text-3xl font-bold text-white">Waar kunnen we u mee helpen?</h2>
              <p class="text-gray-400 mt-2">Vul uw gegevens in; we nemen contact met u op over uw aanvraag.</p>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="name" class="block text-sm font-medium text-gray-500 uppercase tracking-widest mb-3">
                  Naam *
                </label>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  required
                  autocomplete="name"
                  class="w-full px-0 py-4 bg-transparent border-0 border-b-2 border-gray-700 focus:border-brand focus:ring-0 text-lg text-white transition-colors"
                />
              </div>
              <div>
                <label for="phone" class="block text-sm font-medium text-gray-500 uppercase tracking-widest mb-3">
                  Telefoon
                </label>
                <input 
                  type="tel" 
                  id="phone" 
                  name="phone"
                  autocomplete="tel"
                  class="w-full px-0 py-4 bg-transparent border-0 border-b-2 border-gray-700 focus:border-brand focus:ring-0 text-lg text-white transition-colors"
                />
              </div>
            </div>
            
            <div>
              <label for="email" class="block text-sm font-medium text-gray-500 uppercase tracking-widest mb-3">
                E-mail *
              </label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required
                autocomplete="email"
                class="w-full px-0 py-4 bg-transparent border-0 border-b-2 border-gray-700 focus:border-brand focus:ring-0 text-lg text-white transition-colors"
              />
            </div>

            <div>
              <label for="company" class="block text-sm font-medium text-gray-500 uppercase tracking-widest mb-3">Bedrijf <span class="normal-case tracking-normal">(optioneel)</span></label>
              <input type="text" id="company" name="company" autocomplete="organization" class="w-full px-0 py-4 bg-transparent border-0 border-b-2 border-gray-700 focus:border-brand focus:ring-0 text-lg text-white transition-colors" />
            </div>

            <div>
              <label for="vehicle" class="block text-sm font-medium text-gray-500 uppercase tracking-widest mb-3">Voertuig <span class="normal-case tracking-normal">(optioneel)</span></label>
              <input type="text" id="vehicle" name="vehicle" placeholder="Bijvoorbeeld: merk, model en bouwjaar" class="w-full px-0 py-4 bg-transparent border-0 border-b-2 border-gray-700 focus:border-brand focus:ring-0 text-lg text-white transition-colors placeholder:text-gray-600" />
            </div>
            
            <div>
              <label for="service" class="block text-sm font-medium text-gray-500 uppercase tracking-widest mb-3">
                Dienst
              </label>
              <select 
                id="service" 
                name="service"
                class="w-full px-0 py-4 bg-transparent border-0 border-b-2 border-gray-700 focus:border-brand focus:ring-0 text-lg text-white transition-colors cursor-pointer"
              >
                <option value="" class="bg-gray-900">Selecteer een dienst</option>
                <option value="voertuigvolgsystemen" class="bg-gray-900">Voertuigvolgsysteem / ritregistratie</option>
                <option value="gps-startonderbreker" class="bg-gray-900">GPS + startonderbreker</option>
                <option value="dashcams" class="bg-gray-900">Dashcam inbouw</option>
                <option value="alarmsystemen" class="bg-gray-900">Alarmsystemen</option>
                <option value="tachograaf" class="bg-gray-900">Remote tachograaf download</option>
                <option value="can-bus" class="bg-gray-900">CAN-bus koppeling</option>
                <option value="driver-id" class="bg-gray-900">Driver ID / RFID</option>
                <option value="io-integraties" class="bg-gray-900">I/O integratie</option>
                <option value="temperatuur-monitoring" class="bg-gray-900">Temperatuurmonitoring</option>
                <option value="target-blu-eye" class="bg-gray-900">Target Blu Eye 2</option>
                <option value="trekhaken" class="bg-gray-900">Trekhaak</option>
                <option value="anders" class="bg-gray-900">Anders</option>
              </select>
            </div>
            
            <div>
              <label for="message" class="block text-sm font-medium text-gray-500 uppercase tracking-widest mb-3">
                Bericht *
              </label>
              <textarea 
                id="message" 
                name="message" 
                rows="4" 
                required
                placeholder="Beschrijf kort uw vraag of gewenste installatie."
                class="w-full px-0 py-4 bg-transparent border-0 border-b-2 border-gray-700 focus:border-brand focus:ring-0 text-lg text-white transition-colors resize-none"
              ></textarea>
            </div>
            
            <button 
              type="submit"
              class="group w-full rounded-full bg-brand text-white py-5 text-lg font-semibold hover:bg-white hover:text-black transition-all duration-300 flex items-center justify-center gap-3 mt-8"
            >
              Verstuur bericht
              <span class="group-hover:translate-x-2 transition-transform duration-300">→</span>
            </button>
            <p class="text-sm text-gray-500 text-center">Uw aanvraag is vrijblijvend. Bekijk ook ons <a href="/privacy/" class="text-gray-300 underline hover:text-white">privacybeleid</a>.</p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Location Section -->
  <section class="py-24 bg-black">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <!-- Address Card -->
        <div class="reveal">
          <p class="text-brand font-medium tracking-widest uppercase mb-6">Locatie</p>
          <div class="bg-gray-900 border border-gray-800 p-8 md:p-10 relative overflow-hidden">
            <!-- Decorative accent -->
            <div class="absolute top-0 left-0 w-1 h-full bg-brand"></div>
            
            <div class="space-y-6">
              <div>
                <h3 class="text-2xl md:text-3xl font-bold text-white mb-2">
                  Scharloo-Install B.V.
                </h3>
                <p class="text-gray-500 text-sm uppercase tracking-widest">Bezoekadres</p>
              </div>
              
              <div class="space-y-2 text-lg text-gray-300">
                <p class="flex items-start gap-3">
                  <span class="text-brand mt-1">📍</span>
                  <span>
                    Leeghwaterstraat 33-05<br />
                    2811 DT Reeuwijk<br />
                    Nederland
                  </span>
                </p>
              </div>
              
              <a 
                href="https://www.google.com/maps/dir//Leeghwaterstraat+33-05,+2811+DT+Reeuwijk" 
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex items-center gap-3 text-brand hover:text-white transition-colors font-semibold mt-4"
              >
                Route plannen
                <span class="group-hover:translate-x-2 transition-transform duration-300">→</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Map -->
        <div class="reveal">
          <div class="relative aspect-square md:aspect-[4/3] overflow-hidden border border-gray-800">
            <!-- Dark themed map -->
            <iframe 
              src="https://maps.google.com/maps?q=Leeghwaterstraat+33-05,+2811+DT+Reeuwijk,+Netherlands&t=&z=15&ie=UTF8&iwloc=&output=embed"
              width="100%" 
              height="100%" 
              style="border:0; filter: grayscale(100%) invert(92%) contrast(83%);" 
              allowfullscreen="" 
              loading="lazy" 
              referrerpolicy="no-referrer-when-downgrade"
              title="Locatie Scharloo-Install B.V."
              class="absolute inset-0"
            ></iframe>
            <!-- Dark overlay for brand consistency -->
            <div class="absolute inset-0 bg-brand/10 pointer-events-none"></div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  /** @type {HTMLSelectElement | null} */
  const serviceSelect = document.querySelector('#service');
  const requestedService = new URLSearchParams(window.location.search).get('dienst');
  if (serviceSelect && requestedService && [...serviceSelect.options].some((option) => option.value === requestedService)) {
    serviceSelect.value = requestedService;
  }
</script>
