---
import Layout from '../layouts/Layout.astro';

const reasons = [
  { title: 'Professionaliteit', description: 'Installaties volgens de hoogste standaard' },
  { title: 'Oog voor kwaliteit', description: 'Nauwkeurig en betrouwbaar uitgevoerd' },
  { title: 'Klanttevredenheid', description: 'Wij denken mee met wensen en projecten' },
  { title: 'Flexibiliteit', description: 'Ons team is flexibel inzetbaar, op de gewenste planning en locatie' },
  { title: 'Meedenkend', description: 'Oplossingen op maat die beide partijen sterker maken' },
];

const partners = [
  { name: 'GPS-Buddy', logo: '/images/partners/gps-buddy.svg', url: 'https://www.gps-buddy.com/nl/' },
  { name: 'Allsetra', logo: '/images/partners/allsetra.png', url: 'https://allsetra.nl' },
  { name: 'RouteConnect', logo: '/images/partners/routeconnect.webp', url: 'https://routeconnect.com' },
  { name: 'Linqo', logo: '/images/partners/linqo.png', url: 'https://linqo.nl/produkte/routes-en-taken/' },
  { name: 'Suivo', logo: '/images/partners/suivo.png', url: 'https://www.suivo.com/nl/' },
  { name: 'Fleets Online', logo: '/images/partners/Fleets-Online.png', url: 'https://fleets-online.com/' },
];
---

<Layout title="Samenwerken" description="Word onze partner in professionele voertuiginstallaties. Wij geloven in lange-termijn samenwerkingen die voor beide partijen waarde creëren.">
  <!-- Hero -->
  <section class="min-h-[60vh] bg-black text-white flex items-end pb-20 relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="max-w-7xl mx-auto px-6 lg:px-8 w-full">
      <p class="text-brand font-medium tracking-widest uppercase mb-4 animate-fade-in-up">Samenwerken</p>
      <h1 class="heading-xl animate-fade-in-up delay-100" style="opacity: 0;">
        Word onze<br />
        <span class="text-gray-500">partner</span>
      </h1>
      <p class="text-xl text-gray-400 max-w-2xl mt-8 animate-fade-in-up delay-200" style="opacity: 0;">
        in professionele voertuiginstallaties
      </p>
    </div>
  </section>

  <!-- Intro -->
  <section class="py-24 bg-gray-950">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="max-w-3xl reveal">
        <p class="text-xl text-gray-400 leading-relaxed">
          Bij <span class="text-white font-bold">Scharloo-Install B.V.</span> gelooft <span class="text-white font-bold">ons team</span> in <span class="text-white font-semibold">lange-termijn samenwerkingen</span> die voor beide partijen waarde creëren. Of het nu gaat om voertuigvolgsystemen, dashcams of alarmsystemen, wij werken met partners die willen groeien en profiteren van professionaliteit, oog voor kwaliteit en maximale klanttevredenheid.
        </p>
        <p class="text-xl text-gray-400 leading-relaxed mt-6">
          <span class="text-white font-bold">Ons team</span> is <span class="text-white font-semibold">flexibel inzetbaar</span>, op de gewenste planning en locatie, en denkt actief mee over oplossingen op maat, zodat projecten efficiënt en betrouwbaar worden uitgevoerd.
        </p>
      </div>
    </div>
  </section>

  <!-- Why Partner -->
  <section class="py-24 bg-black">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="reveal">
        <p class="text-brand font-medium tracking-widest uppercase mb-4">Waarom samenwerken</p>
        <h2 class="heading-lg mb-12">
          Waarom samenwerken<br />
          <span class="text-gray-500">met Scharloo-Install?</span>
        </h2>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {reasons.map((reason, i) => (
          <div class="reveal motion-card bg-gray-950 rounded-2xl ring-1 ring-white/10 hover:ring-brand p-8 transition-all">
            <span class="flex items-center justify-center w-12 h-12 rounded-xl bg-brand/15 text-brand mb-5">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
            </span>
            <h3 class="text-2xl font-bold mb-2">{reason.title}</h3>
            <p class="text-gray-400">{reason.description}</p>
          </div>
        ))}
      </div>
      
      <p class="text-xl text-gray-400 mt-12 reveal">
        Samen met <span class="text-white font-bold">ons team</span> bouwen we aan een <span class="text-white font-semibold">duurzame samenwerking</span>, waarbij beide partijen profiteren van ervaring en expertise.
      </p>
    </div>
  </section>

  <!-- Trusted By -->
  <section class="py-24 bg-gray-950">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="reveal">
        <p class="text-brand font-medium tracking-widest uppercase mb-4 text-center">Trusted by</p>
        <h2 class="heading-lg mb-12 text-center">
          <span class="text-white font-bold">Ons team</span> werkt al<br />
          <span class="text-gray-500">succesvol samen met</span>
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
          {partners.map(partner => (
            <a href={partner.url} target="_blank" rel="noopener noreferrer" class="flex flex-col items-center justify-between p-6 rounded-2xl bg-white border-2 border-gray-200 hover:border-brand hover:shadow-2xl hover:shadow-brand/20 hover:scale-105 transition-all duration-300 group min-h-[180px]">
              <span class="text-black font-semibold text-sm text-center">{partner.name}</span>
              <img
                src={partner.logo}
                alt={partner.name}
                class={`max-h-16 w-auto object-contain ${partner.name === 'Suivo' ? 'mt-[-15px]' : ''}`}
                onerror="this.style.display='none'"
              />
              <div></div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-24 md:py-32 bg-black overflow-hidden border-t border-white/10 reveal">
    <div class="absolute -top-40 right-[-10%] w-[45rem] h-[45rem] bg-brand/15 rounded-full blur-3xl" aria-hidden="true"></div>
    <div class="absolute -bottom-40 left-[-10%] w-[45rem] h-[45rem] bg-brand/10 rounded-full blur-3xl" aria-hidden="true"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-6 lg:px-8 text-center">
      <p class="text-brand font-medium tracking-widest uppercase mb-4">Samenwerken</p>
      <h2 class="heading-lg mb-6">Klaar om<br /><span class="text-brand">samen te werken?</span></h2>
      <p class="text-lg text-gray-300 mb-10 max-w-2xl mx-auto">Wij staan altijd open voor nieuwe waardevolle samenwerkingen. Neem contact op en ontdek hoe we samen sterker kunnen groeien.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-10">
        <a href="/contact/#formulier" class="motion-button group inline-flex items-center justify-center gap-3 bg-brand text-white rounded-full px-9 py-4 text-lg font-bold hover:bg-white hover:text-black transition-all duration-300">Neem contact op <span class="group-hover:translate-x-1 transition-transform duration-300">→</span></a>
        <a href="/diensten/" class="inline-flex items-center justify-center gap-3 rounded-full border border-white/20 text-white px-9 py-4 text-lg font-semibold hover:border-brand hover:text-brand transition-colors">Bekijk onze diensten</a>
      </div>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="tel:+31182796197" class="inline-flex items-center gap-2.5 rounded-full bg-white/5 ring-1 ring-white/10 px-5 py-3 text-gray-200 hover:ring-brand hover:text-white transition-all">
          <svg class="w-4 h-4 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
          (0182) 79 61 97
        </a>
        <a href="mailto:info@scharloo-install.nl" class="inline-flex items-center gap-2.5 rounded-full bg-white/5 ring-1 ring-white/10 px-5 py-3 text-gray-200 hover:ring-brand hover:text-white transition-all">
          <svg class="w-4 h-4 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
          info@scharloo-install.nl
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  const reveals = document.querySelectorAll('.reveal');
  
  const revealOnScroll = () => {
    reveals.forEach(el => {
      const top = el.getBoundingClientRect().top;
      if (top < window.innerHeight - 100) {
        el.classList.add('active');
      }
    });
  };
  
  window.addEventListener('scroll', revealOnScroll);
  revealOnScroll();
</script>
