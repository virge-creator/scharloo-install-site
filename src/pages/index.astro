---
import Layout from '../layouts/Layout.astro';
import { diensten, dienstUrl } from '../data/diensten';

const reasons = [
  'Gespecialiseerd in voertuigsystemen',
  'Nette en professionele afwerking',
  'Flexibel inzetbaar',
  'Ervaring met diverse merken en systemen',
  'Actief in Nederland en België',
];

// Media-muur: tegels met een korte preview-video (plaats de MP4's in /public/videos/).
// Zolang de MP4 er nog niet is, toont de poster (een bestaande foto) — nooit een leeg vak.
const reels = [
  { video: '/videos/reel-1.mp4', poster: '/videos/reel-1.jpg', titel: 'In onze werkplaats', bron: 'tiktok' },
  { video: '/videos/reel-2.mp4', poster: '/videos/reel-2.jpg', titel: 'Target Blu Eye in beeld', bron: 'instagram' },
  { video: '/videos/reel-3.mp4', poster: '/videos/reel-3.jpg', titel: 'Strak afgewerkt', bron: 'tiktok' },
  { video: '/videos/reel-4.mp4', poster: '/videos/reel-4.jpg', titel: 'Vakwerk van dichtbij', bron: 'instagram' },
];

const tiktokUrl = 'https://www.tiktok.com/@scharlooinstall';
const instagramUrl = 'https://www.instagram.com/scharloo_install';
---

<Layout title="Voertuigsystemen professioneel ingebouwd" description="Scharloo-Install bouwt voertuigvolgsystemen, alarmsystemen, dashcams en voertuigtechniek netjes in. Voor particulieren, bedrijven en wagenparken in Nederland en België.">
  <!-- Hero Section met achtergrondvideo -->
  <section class="relative min-h-screen bg-black text-white flex flex-col justify-center overflow-hidden">
    <!-- Achtergrondvideo (valt terug op de poster-foto tot de MP4 is geplaatst) -->
    <video
      class="hero-bg-video absolute inset-0 w-full h-full object-cover object-center z-0"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/videos/hero-poster.jpg"
      aria-hidden="true"
    >
      <source src="/videos/hero.mp4" type="video/mp4" />
    </video>
    <!-- Donkere laag voor leesbaarheid -->
    <div class="absolute inset-0 z-[1]" style="background: linear-gradient(to bottom, rgba(0,0,0,.62), rgba(0,0,0,.60) 45%, rgba(0,0,0,.90));"></div>
    <div class="hero-glow z-[2]" aria-hidden="true"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 py-20 w-full">
      <div class="space-y-8">
        <p class="text-brand font-medium tracking-widest uppercase animate-fade-in-up">Voertuigtechniek, zorgvuldig ingebouwd</p>

        <h1 class="heading-xl animate-fade-in-up delay-100" style="opacity: 0;">
          Voertuigsystemen<br />
          <span class="text-brand">professioneel</span> ingebouwd
        </h1>

        <p class="text-xl md:text-2xl text-gray-200 max-w-2xl animate-fade-in-up delay-200" style="opacity: 0;">
          Van GPS-tracking en voertuigbeveiliging tot dashcams en maatwerkintegraties. Netjes ingebouwd voor één voertuig of uw hele wagenpark.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 pt-6 animate-fade-in-up delay-300" style="opacity: 0;">
          <a
            href="/contact/#formulier"
            class="group bg-brand text-white rounded-full px-8 py-4 text-lg font-semibold hover:bg-white hover:text-black transition-all duration-300 inline-flex items-center justify-center gap-3"
          >
            Offerte aanvragen
            <span class="group-hover:translate-x-2 transition-transform duration-300">→</span>
          </a>
          <a
            href="/diensten/"
            class="border-2 border-white text-white rounded-full px-8 py-4 text-lg font-semibold hover:bg-white hover:text-black transition-all duration-300 text-center"
          >
            Bekijk onze diensten
          </a>
        </div>

        <!-- Social chips -->
        <div class="flex flex-wrap items-center gap-3 pt-2 animate-fade-in-up delay-300">
          <a href={tiktokUrl} target="_blank" rel="noopener" class="group inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/5 backdrop-blur px-4 py-2 text-sm font-semibold hover:bg-white hover:text-black transition-all duration-300">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.5 3h-2.9v12.4a2.3 2.3 0 1 1-2.3-2.3c.2 0 .5 0 .7.1V10.2a5.3 5.3 0 1 0 4.5 5.2V8.9a6.5 6.5 0 0 0 3.9 1.3V7.3a3.6 3.6 0 0 1-3.6-3.6 3.7 3.7 0 0 1-.3-.7Z"/></svg>
            TikTok
          </a>
          <a href={instagramUrl} target="_blank" rel="noopener" class="group inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/5 backdrop-blur px-4 py-2 text-sm font-semibold hover:bg-white hover:text-black transition-all duration-300">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg>
            Instagram
          </a>
          <span class="text-sm text-gray-300">Elke woensdag om 19:00 een nieuwe video</span>
        </div>
      </div>

      <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3 text-sm md:text-base text-gray-200 animate-fade-in-up delay-300">
        <span><span class="text-brand mr-2">✓</span>Voor particulier en zakelijk</span>
        <span><span class="text-brand mr-2">✓</span>Eén voertuig of wagenpark</span>
        <span><span class="text-brand mr-2">✓</span>Actief in Nederland en België</span>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce z-10">
      <svg class="w-6 h-6 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </section>

  <!-- Media-muur: Bekend van onze video's -->
  <section class="py-24 md:py-32 bg-gray-950 relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-end mb-12">
        <div class="reveal">
          <p class="text-brand font-medium tracking-widest uppercase mb-4">Volg ons</p>
          <h2 class="heading-lg">
            Bekend van<br />
            <span class="text-gray-500">onze video's</span>
          </h2>
          <p class="text-lg text-gray-400 mt-6 max-w-xl">
            Van inbouw tot afwerking: we laten ons werk zien op TikTok en Instagram. Elke woensdag om 19:00 uur een nieuwe video.
          </p>
        </div>
        <div class="reveal flex flex-wrap gap-3 lg:justify-end">
          <a href={tiktokUrl} target="_blank" rel="noopener" class="motion-button inline-flex items-center gap-2 bg-white text-black rounded-full px-6 py-3 font-semibold hover:bg-brand hover:text-white transition-all duration-300">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.5 3h-2.9v12.4a2.3 2.3 0 1 1-2.3-2.3c.2 0 .5 0 .7.1V10.2a5.3 5.3 0 1 0 4.5 5.2V8.9a6.5 6.5 0 0 0 3.9 1.3V7.3a3.6 3.6 0 0 1-3.6-3.6 3.7 3.7 0 0 1-.3-.7Z"/></svg>
            @scharlooinstall
          </a>
          <a href={instagramUrl} target="_blank" rel="noopener" class="motion-button inline-flex items-center gap-2 rounded-full px-6 py-3 font-semibold text-white transition-all duration-300" style="background: linear-gradient(45deg, #f09433, #dc2743 50%, #bc1888);">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg>
            @scharloo_install
          </a>
        </div>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5 reveal">
        {reels.map((reel) => (
          <a
            href={reel.bron === 'tiktok' ? tiktokUrl : instagramUrl}
            target="_blank"
            rel="noopener"
            class="reel-tile group relative block aspect-[9/16] rounded-2xl overflow-hidden ring-1 ring-white/10 bg-black"
          >
            <video
              class="reel-video absolute inset-0 w-full h-full object-cover"
              muted
              loop
              playsinline
              preload="none"
              poster={reel.poster}
            >
              <source src={reel.video} type="video/mp4" />
            </video>
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-black/30 transition-opacity duration-300 group-hover:from-black/70"></div>
            <!-- Bron-badge -->
            <span class="absolute top-3 left-3 flex items-center justify-center w-9 h-9 rounded-full bg-black/55 backdrop-blur ring-1 ring-white/20" aria-hidden="true">
              {reel.bron === 'tiktok' ? (
                <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M16.5 3h-2.9v12.4a2.3 2.3 0 1 1-2.3-2.3c.2 0 .5 0 .7.1V10.2a5.3 5.3 0 1 0 4.5 5.2V8.9a6.5 6.5 0 0 0 3.9 1.3V7.3a3.6 3.6 0 0 1-3.6-3.6 3.7 3.7 0 0 1-.3-.7Z"/></svg>
              ) : (
                <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg>
              )}
            </span>
            <!-- Play-icoon -->
            <span class="absolute inset-0 flex items-center justify-center transition-opacity duration-300 group-hover:opacity-0" aria-hidden="true">
              <span class="flex items-center justify-center w-14 h-14 rounded-full bg-white/15 backdrop-blur ring-1 ring-white/30">
                <svg class="w-6 h-6 text-white translate-x-0.5" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </span>
            </span>
            <span class="absolute bottom-3 left-3 right-3 text-sm font-semibold text-white drop-shadow">{reel.titel}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Intro Section -->
  <section class="py-24 bg-black">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="max-w-3xl reveal">
        <p class="text-brand font-medium tracking-widest uppercase mb-4">Over ons</p>
        <h2 class="heading-lg mb-8">
          Uw partner voor<br />
          <span class="text-gray-500">professionele inbouw</span>
        </h2>
        <p class="text-xl text-gray-400 leading-relaxed">
          Scharloo-Install B.V. verzorgt professionele inbouw van telematica en voertuigelektronica voor particulieren en bedrijven. Van één auto tot een volledig wagenpark: we denken mee over de juiste oplossing en leveren netjes op.
        </p>
      </div>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="py-28 bg-gray-950">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <!-- Section header with video -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 mb-20 items-center">
        <div class="reveal">
          <p class="text-brand font-medium tracking-widest uppercase mb-4">Diensten</p>
          <h2 class="heading-lg">
            Onze<br />
            <span class="text-gray-500">diensten</span>
          </h2>
        </div>
        <!-- YouTube Short (Portrait) -->
        <div class="reveal flex justify-center lg:justify-end image-zoom">
          <div class="video-card">
            <iframe
              src="https://www.youtube.com/embed/Vykfc3ZDeMw"
              title="Bekijk een installatie van Scharloo-Install"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        </div>
      </div>

      <!-- Services list -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-0 border-t border-gray-800 reveal">
        {diensten.map((service, i) => (
          <a
            href={dienstUrl(service)}
            class={`group motion-card py-8 md:py-12 border-b border-gray-800 flex items-center justify-between hover:bg-gray-900 transition-colors px-4 md:px-8 ${i % 2 === 0 ? 'md:border-r' : ''}`}
            style={`--item-index:${i}`}
          >
            <span class="text-2xl md:text-3xl font-bold group-hover:text-brand transition-colors">
              {service.title}
            </span>
            <span class="text-3xl text-gray-600 group-hover:text-brand group-hover:translate-x-2 transition-all duration-300">
              →
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-32 bg-black">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="reveal">
          <p class="text-brand font-medium tracking-widest uppercase mb-4">Waarom wij</p>
          <h2 class="heading-lg mb-8">
            Waarom<br />
            <span class="text-gray-500">Scharloo-Install</span>
          </h2>
          <ul class="space-y-4">
            {reasons.map(reason => (
              <li class="flex items-center gap-4 text-xl text-gray-300">
                <span class="text-brand text-2xl">✓</span>
                {reason}
              </li>
            ))}
          </ul>
        </div>
        <div class="reveal photo-card photo-card-accent">
          <img
            src="/images/team-homepage.jpg"
            alt="Het Scharloo-Install team"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-32 bg-brand text-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center reveal">
      <h2 class="heading-lg mb-8">
        Op zoek naar een betrouwbare inbouwpartner?
      </h2>
      <p class="text-xl text-white/80 mb-12 max-w-2xl mx-auto">
        Vertel ons welk systeem u zoekt en in welk voertuig het moet worden ingebouwd. We denken mee over een passende oplossing en maken graag een vrijblijvende offerte.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/contact/#formulier"
          class="group inline-flex items-center gap-3 bg-white text-brand rounded-full px-10 py-5 text-xl font-bold hover:bg-black hover:text-white transition-all duration-300"
        >
          Vraag vrijblijvend een offerte aan
          <span class="group-hover:translate-x-2 transition-transform duration-300">→</span>
        </a>
      </div>
      <div class="mt-12 text-white/80">
        <p class="text-lg"><a href="tel:+31182796197" class="hover:text-white transition-colors">📞 (0182) 79 61 97</a></p>
        <p class="text-lg"><a href="mailto:info@scharloo-install.nl" class="hover:text-white transition-colors">✉ info@scharloo-install.nl</a></p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-bg-video { filter: saturate(1.05); }
  .reel-tile .reel-video { transition: transform 700ms cubic-bezier(.2,.75,.25,1); }
  .reel-tile:hover .reel-video { transform: scale(1.06); }
  /* Poster-foto blijft altijd zichtbaar; alleen de beweging stopt via JS. */
</style>

<script>
  // Media-tegels: preview afspelen bij hover (desktop), op mobiel toont de poster.
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll('.reel-tile').forEach((tile) => {
    const video = tile.querySelector('video');
    if (!video) return;
    tile.addEventListener('mouseenter', () => { video.play().catch(() => {}); });
    tile.addEventListener('mouseleave', () => { video.pause(); video.currentTime = 0; });
  });

  // Achtergrondvideo pauzeren bij 'reduced motion'.
  const heroVideo = document.querySelector('.hero-bg-video');
  if (heroVideo && prefersReduced) { heroVideo.pause(); }
</script>
