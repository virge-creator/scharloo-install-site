  #google-reviews .sr-stars { color:#FBBC05; letter-spacing:2px; }
  #google-reviews .sr-sum-sub { color:#9ca3af; font-size:.85rem; margin-top:.35rem; }
  #google-reviews .sr-sum-btns { display:flex; gap:.6rem; flex-wrap:wrap; justify-content:center; }
  #google-reviews .sr-btn { display:inline-flex; align-items:center; gap:.4rem; border-radius:9999px; padding:.6rem 1.25rem; font-weight:600; font-size:.9rem; transition:all .25s ease; white-space:nowrap; text-decoration:none; }
  #google-reviews .sr-btn-primary { background:var(--color-brand,#1681DE); color:#fff; }
  #google-reviews .sr-btn-primary:hover { background:#fff; color:#000; }
  #google-reviews .sr-btn-ghost { border:1px solid rgba(255,255,255,.22); color:#fff; }
