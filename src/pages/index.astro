  }
  .brand-word {
    font-weight: 800; font-size: 1.6rem; letter-spacing: 0.04em;
    color: #4b5563; transition: color .3s ease;
  }
  .brand-word:hover { color: #fff; }
  @keyframes merquee-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .merquee-track { animation: none; justify-content: center; flex-wrap: wrap; gap: 1.5rem 2.5rem; white-space: normal; }
  }

</style>

<!-- Review-stijlen globaal: de kaarten worden via JS ingevoegd en krijgen anders geen scoped CSS -->
