---
import Layout from '../layouts/Layout.astro';
import { diensten, dienstUrl } from '../data/diensten';

const reasons = [
  'Gespecialiseerd in voertuigsystemen',
  'Nette en professionele afwerking',
  'Flexibel inzetbaar',
  'Ervaring met diverse merken en systemen',
  'Actief in Nederland en België',
];
---

<Layout title="Voertuigsystemen professioneel ingebouwd" description="Scharloo-Install bouwt voertuigvolgsystemen, alarmsystemen, dashcams en voertuigtechniek netjes in. Voor particulieren, bedrijven en wagenparken in Nederland en België.">
  <!-- Hero Section -->
  <section class="min-h-screen bg-black text-white flex flex-col justify-center relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 py-20">
      <div class="space-y-8 relative z-10">
        <!-- Tagline -->
        <p class="text-brand font-medium tracking-widest uppercase animate-fade-in-up">Voertuigtechniek, zorgvuldig ingebouwd</p>
        
        <!-- Main heading -->
        <h1 class="heading-xl animate-fade-in-up delay-100" style="opacity: 0;">
          Voertuigsystemen<br />
          <span class="text-brand">professioneel</span> ingebouwd
        </h1>
        
        <!-- Subtext -->
        <p class="text-xl md:text-2xl text-gray-400 max-w-2xl animate-fade-in-up delay-200" style="opacity: 0;">
          Van GPS-tracking en voertuigbeveiliging tot dashcams en maatwerkintegraties. Netjes ingebouwd voor één voertuig of uw hele wagenpark.
        </p>
        
        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 pt-8 animate-fade-in-up delay-300" style="opacity: 0;">
          <a 
            href="/contact/#formulier" 
            class="group bg-brand text-white rounded-full px-8 py-4 text-lg font-semibold hover:bg-white hover:text-black transition-all duration-300 inline-flex items-center justify-center gap-3"
          >
            Offerte aanvragen
            <span class="group-hover:translate-x-2 transition-transform duration-300">→</span>
          </a>
          <a 
            href="/diensten/" 
            class="border-2 border-white text-white rounded-full px-8 py-4 text-lg font-semibold hover:bg-white hover:text-black transition-all duration-300 text-center"
          >
            Bekijk onze diensten
          </a>
        </div>
      </div>

      <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3 text-sm md:text-base text-gray-300 animate-fade-in-up delay-300">
        <span><span class="text-brand mr-2">✓</span>Voor particulier en zakelijk</span>
        <span><span class="text-brand mr-2">✓</span>Eén voertuig of wagenpark</span>
        <span><span class="text-brand mr-2">✓</span>Actief in Nederland en België</span>
      </div>

    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </section>

  <!-- Intro Section -->
  <section class="py-24 bg-gray-950">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="max-w-3xl reveal">
        <p class="text-brand font-medium tracking-widest uppercase mb-4">Over ons</p>
        <h2 class="heading-lg mb-8">
          Uw partner voor<br />
          <span class="text-gray-500">professionele inbouw</span>
        </h2>
        <p class="text-xl text-gray-400 leading-relaxed">
          Scharloo-Install B.V. verzorgt professionele inbouw van telematica en voertuigelektronica voor particulieren en bedrijven. Van één auto tot een volledig wagenpark: we denken mee over de juiste oplossing en leveren netjes op.
        </p>
      </div>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="py-32 bg-black">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <!-- Section header with video -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 mb-20 items-center">
        <div class="reveal">
          <p class="text-brand font-medium tracking-widest uppercase mb-4">Diensten</p>
          <h2 class="heading-lg">
            Onze<br />
            <span class="text-gray-500">diensten</span>
          </h2>
        </div>
        <!-- YouTube Short (Portrait) -->
        <div class="reveal flex justify-center lg:justify-end image-zoom">
          <div class="video-card">
            <iframe 
              src="https://www.youtube.com/embed/Vykfc3ZDeMw" 
              title="Bekijk een installatie van Scharloo-Install"
              frameborder="0" 
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
              allowfullscreen
            ></iframe>
          </div>
        </div>
      </div>
      
      <!-- Services list -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-0 border-t border-gray-800 reveal">
        {diensten.map((service, i) => (
          <a 
            href={dienstUrl(service)}
            class={`group motion-card py-8 md:py-12 border-b border-gray-800 flex items-center justify-between hover:bg-gray-900 transition-colors px-4 md:px-8 ${i % 2 === 0 ? 'md:border-r' : ''}`}
            style={`--item-index:${i}`}
          >
            <span class="text-2xl md:text-3xl font-bold group-hover:text-brand transition-colors">
              {service.title}
            </span>
            <span class="text-3xl text-gray-600 group-hover:text-brand group-hover:translate-x-2 transition-all duration-300">
              →
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-32 bg-gray-950">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="reveal">
          <p class="text-brand font-medium tracking-widest uppercase mb-4">Waarom wij</p>
          <h2 class="heading-lg mb-8">
            Waarom<br />
            <span class="text-gray-500">Scharloo-Install</span>
          </h2>
          <ul class="space-y-4">
            {reasons.map(reason => (
              <li class="flex items-center gap-4 text-xl text-gray-300">
                <span class="text-brand text-2xl">✓</span>
                {reason}
              </li>
            ))}
          </ul>
        </div>
        <div class="reveal photo-card photo-card-accent">
          <img 
            src="/images/team-homepage.jpg" 
            alt="Het Scharloo-Install team" 
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Social / Volg ons -->
  <section class="py-32 bg-black relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
      <div class="reveal text-center max-w-3xl mx-auto mb-16">
        <p class="text-brand font-medium tracking-widest uppercase mb-4">Volg ons</p>
        <h2 class="heading-lg mb-6">
          Zie ons werk<br />
          <span class="text-gray-500">op social media</span>
        </h2>
        <p class="text-xl text-gray-400 leading-relaxed">
          Elke woensdag om 19:00 uur een nieuwe video. Van inbouw tot techniek: volg ons op TikTok en Instagram en mis niets.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
        <!-- TikTok: live feed -->
        <div class="reveal motion-card flex flex-col">
          <div class="flex items-center justify-between mb-5">
            <div class="flex items-center gap-3">
              <span class="flex items-center justify-center w-11 h-11 rounded-xl bg-white/5 ring-1 ring-white/10" aria-hidden="true">
                <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M16.5 3h-2.9v12.4a2.3 2.3 0 1 1-2.3-2.3c.2 0 .5 0 .7.1V10.2a5.3 5.3 0 1 0 4.5 5.2V8.9a6.5 6.5 0 0 0 3.9 1.3V7.3a3.6 3.6 0 0 1-3.6-3.6 3.7 3.7 0 0 1-.3-.7Z"/></svg>
              </span>
              <div>
                <p class="font-bold text-lg leading-tight">TikTok</p>
                <a href="https://www.tiktok.com/@scharlooinstall" target="_blank" rel="noopener" class="text-sm text-gray-400 hover:text-brand transition-colors">@scharlooinstall</a>
              </div>
            </div>
            <a href="https://www.tiktok.com/@scharlooinstall" target="_blank" rel="noopener" class="text-sm font-semibold text-brand hover:text-white transition-colors">Volgen →</a>
          </div>
          <div class="bg-white rounded-2xl p-2 ring-1 ring-white/10 flex-1 min-h-[520px] overflow-hidden">
            <blockquote
              class="tiktok-embed"
              cite="https://www.tiktok.com/@scharlooinstall"
              data-unique-id="scharlooinstall"
              data-embed-type="creator"
              style="max-width: 100%; min-width: 288px; margin: 0;"
            >
              <section>
                <a target="_blank" rel="noopener" href="https://www.tiktok.com/@scharlooinstall">@scharlooinstall</a>
              </section>
            </blockquote>
          </div>
        </div>

        <!-- Instagram -->
        <div class="reveal motion-card flex flex-col">
          <div class="flex items-center justify-between mb-5">
            <div class="flex items-center gap-3">
              <span class="flex items-center justify-center w-11 h-11 rounded-xl bg-white/5 ring-1 ring-white/10" aria-hidden="true">
                <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg>
              </span>
              <div>
                <p class="font-bold text-lg leading-tight">Instagram</p>
                <a href="https://www.instagram.com/scharloo_install" target="_blank" rel="noopener" class="text-sm text-gray-400 hover:text-brand transition-colors">@scharloo_install</a>
              </div>
            </div>
            <a href="https://www.instagram.com/scharloo_install" target="_blank" rel="noopener" class="text-sm font-semibold text-brand hover:text-white transition-colors">Volgen →</a>
          </div>
          <a
            href="https://www.instagram.com/scharloo_install"
            target="_blank"
            rel="noopener"
            class="group relative flex-1 min-h-[520px] rounded-2xl ring-1 ring-white/10 overflow-hidden flex flex-col items-center justify-center text-center p-10"
            style="background: radial-gradient(circle at 30% 20%, rgba(22,129,222,0.25), transparent 60%), linear-gradient(135deg, #1a1a1a 0%, #0a0a0a 100%);"
          >
            <span class="flex items-center justify-center w-20 h-20 rounded-2xl mb-6 transition-transform duration-300 group-hover:scale-110" style="background: linear-gradient(45deg, #f09433, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);" aria-hidden="true">
              <svg class="w-10 h-10 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg>
            </span>
            <p class="text-2xl font-bold mb-3">Bekijk onze reels</p>
            <p class="text-gray-400 max-w-xs mb-8">De nieuwste beelden van onze installaties en projecten vind je op Instagram.</p>
            <span class="inline-flex items-center gap-2 bg-white text-black rounded-full px-7 py-3 font-semibold group-hover:bg-brand group-hover:text-white transition-all duration-300">
              Volg @scharloo_install
              <span class="group-hover:translate-x-1 transition-transform duration-300">→</span>
            </span>
          </a>
        </div>
      </div>
    </div>
    <script async src="https://www.tiktok.com/embed.js"></script>
  </section>

  <!-- CTA Section -->
  <section class="py-32 bg-brand text-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center reveal">
      <h2 class="heading-lg mb-8">
        Op zoek naar een betrouwbare inbouwpartner?
      </h2>
      <p class="text-xl text-white/80 mb-12 max-w-2xl mx-auto">
        Vertel ons welk systeem u zoekt en in welk voertuig het moet worden ingebouwd. We denken mee over een passende oplossing en maken graag een vrijblijvende offerte.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href="/contact/#formulier" 
          class="group inline-flex items-center gap-3 bg-white text-brand rounded-full px-10 py-5 text-xl font-bold hover:bg-black hover:text-white transition-all duration-300"
        >
          Vraag vrijblijvend een offerte aan
          <span class="group-hover:translate-x-2 transition-transform duration-300">→</span>
        </a>
      </div>
      <div class="mt-12 text-white/80">
        <p class="text-lg"><a href="tel:+31182796197" class="hover:text-white transition-colors">📞 (0182) 79 61 97</a></p>
        <p class="text-lg"><a href="mailto:info@scharloo-install.nl" class="hover:text-white transition-colors">✉ info@scharloo-install.nl</a></p>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Scroll reveal animation
  const reveals = document.querySelectorAll('.reveal');
  
  const revealOnScroll = () => {
    reveals.forEach(el => {
      const top = el.getBoundingClientRect().top;
      const windowHeight = window.innerHeight;
      
      if (top < windowHeight - 100) {
        el.classList.add('active');
      }
    });
  };
  
  window.addEventListener('scroll', revealOnScroll);
  revealOnScroll();
</script>
