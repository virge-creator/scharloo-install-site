---
import Layout from '../layouts/Layout.astro';
import { alarmPakketten, volgPakketten } from '../data/alarm.ts';
import Verzekeraars from '../components/Verzekeraars.astro';
import { verzekeraarsTekst } from '../data/verzekeraars';

// Uitleg per klasse, extra tekst voor zoekmachines en bezoekers
const klasseUitleg = [
  {
    naam: 'Klasse 2',
    sub: 'Alarmsysteem',
    foto: '/images/alarm-klasse-2.png',
    tekst: 'Een SCM/CCV alarm klasse 2 combineert een startonderbreker met inbraak- en omtrekbeveiliging. Sensoren detecteren beweging in en rond het voertuig en activeren de noodstroomsirene. Dit is de instap voor een volwaardig auto-alarm en vaak voldoende wanneer uw verzekeraar een alarm eist zonder hellingshoekdetectie.',
  },
  {
    naam: 'Klasse 3',
    sub: 'Alarm + hellingdetectie',
    foto: '/images/alarm-klasse-3.png',
    tekst: 'Een alarm klasse 3 heeft alles van klasse 2 en voegt hellingshoekdetectie toe. Probeert een dief uw voertuig op te krikken of weg te slepen, dan gaat het alarm af. Klasse 3 is de meest gevraagde klasse door verzekeraars en beschermt dankzij eigen autorisatie ook tegen keyless diefstal (de relay attack).',
  },
  {
    naam: 'Klasse 4',
    sub: 'Voertuigvolgsysteem',
    foto: '/images/alarm-klasse-4.png',
    tekst: 'Een klasse 4 voertuigvolgsysteem is een SCM/CCV-gecertificeerd track & trace systeem met aansluiting op een 24/7 meldkamer. Bij diefstal wordt uw voertuig via GPS gevolgd en kan het op afstand worden geblokkeerd. Jammingdetectie merkt het direct wanneer iemand het signaal probeert te verstoren.',
  },
  {
    naam: 'Klasse 5',
    sub: 'Alarm + volgsysteem',
    foto: '/images/alarm-klasse-5.png',
    tekst: 'Klasse 5 is de meest complete oplossing: een alarm gekoppeld aan een voertuigvolgsysteem. Gaat het alarm af, dan ontvangen u én de meldkamer direct een pushmelding, zodat er meteen actie ondernomen kan worden. U combineert zo afschrikking, tracking en opvolging in één systeem. Klasse 5 wordt ingebouwd als koppeling op een bestaand Klasse 3-alarm; is er nog geen Klasse 3 aanwezig, dan installeren wij die eerst.',
  },
  {
    naam: 'Klasse TV',
    sub: 'Peilzender / terugvinden',
    foto: '/images/alarm-klasse-tv.png',
    tekst: 'Het klasse TV terugvindsysteem is een compacte, SCM/CCV-gecertificeerde tracker waarmee uw voertuig na diefstal snel wordt teruggevonden via de meldkamer. Een voordelige oplossing met een laag jaarabonnement, ideaal als aanvulling of voor voertuigen met een lager risicoprofiel.',
  },
];

// Veelgestelde vragen, vangt long-tail zoekopdrachten en voedt de FAQ-structuurdata
const faqs = [
  {
    vraag: 'Is een SCM-alarm verplicht?',
    antwoord: 'Dat hangt af van uw verzekeraar en voertuig. Bij nieuwere of duurdere voertuigen eist de verzekeraar vaak een SCM/CCV-goedgekeurd alarm (meestal klasse 3) of een voertuigvolgsysteem (klasse 4 of 5). Wij adviseren u vrijblijvend welke klasse in uw situatie nodig is.',
  },
  {
    vraag: 'Accepteert mijn verzekeraar een alarm van Scharloo-Install?',
    antwoord: `Ja. Wij zijn een SCM/CCV-erkend inbouwbedrijf en leveren bij elke installatie een geldig SCM/CCV-certificaat. Dat certificaat wordt geaccepteerd door alle Nederlandse autoverzekeraars, waaronder ${verzekeraarsTekst}. Welke klasse u nodig heeft, verschilt per verzekeraar en voertuig; wij zoeken dat vrijblijvend voor u uit.`,
  },
  {
    vraag: 'Welke alarmklasse eist mijn verzekeraar?',
    antwoord: 'Dat hangt af van uw verzekeraar, de cataloguswaarde en het merk en type van uw auto. Bij nieuwere of duurdere auto’s vragen verzekeraars meestal minimaal klasse 3, soms een voertuigvolgsysteem (klasse 4 of 5). Stuur ons uw kenteken en verzekeraar, dan zoeken wij gratis uit welke klasse u nodig heeft.',
  },
  {
    vraag: 'Moet ik het certificaat zelf naar mijn verzekeraar sturen?',
    antwoord: 'Ja. Direct na de inbouw ontvangt u van ons het SCM/CCV-certificaat. Dat stuurt u door naar uw verzekeraar, waarna uw beveiliging is geregistreerd. Lukt dat niet of heeft uw verzekeraar vragen, dan helpen wij u daar graag bij.',
  },
  {
    vraag: 'Wat is het verschil tussen klasse 2 en klasse 3?',
    antwoord: 'Beide hebben een startonderbreker en inbraakdetectie. Klasse 3 voegt hellingshoekdetectie toe, waardoor het alarm ook afgaat bij wegslepen of opkrikken. Daarom vragen verzekeraars meestal om klasse 3.',
  },
  {
    vraag: 'Wat is het verschil tussen klasse 4 en klasse 5?',
    antwoord: 'Klasse 4 is een voertuigvolgsysteem dat los staat van het alarm. Bij klasse 5 is het volgsysteem gekoppeld aan een alarm, zodat een alarmmelding automatisch doorgaat naar de meldkamer, met een pushmelding naar u. Klasse 5 wordt ingebouwd als koppeling op een bestaand Klasse 3-alarm. Heeft uw voertuig nog geen Klasse 3, dan installeren wij die eerst; dat is een voorwaarde voor klasse 5.',
  },
  {
    vraag: 'Wat kost een alarmsysteem inbouwen?',
    antwoord: 'Wij werken met vaste pakketprijzen: klasse 2 voor €849, klasse 3 voor €999, klasse 4 voor €699 en klasse 5 voor €799, inclusief btw, montage en SCM/CCV-certificaat. Bij de voertuigvolgsystemen (klasse 4, 5 en het terugvindsysteem) komt een jaarlijks meldkamerabonnement. U kunt de meeste pakketten direct online bestellen en betalen.',
  },
  {
    vraag: 'Helpt het tegen keyless diefstal (relay attack)?',
    antwoord: 'Ja. Onze systemen werken met eigen autorisatie, waardoor het verlengen van het sleutelsignaal (de relay attack) geen toegang meer geeft tot het starten of wegrijden van uw voertuig.',
  },
  {
    vraag: 'Komen jullie op locatie en krijg ik een certificaat?',
    antwoord: 'Ja, wij bouwen op locatie of in onze werkplaats in Reeuwijk in en zijn inzetbaar door heel Nederland. Na de installatie ontvangt u een geldig SCM/CCV-certificaat.',
  },
];

// FAQ-structuurdata (schema.org), helpt Google de vraag-en-antwoorden te begrijpen
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.vraag,
    acceptedAnswer: { '@type': 'Answer', text: f.antwoord },
  })),
};
---

<Layout
  title="SCM alarm inbouwen | Geaccepteerd door uw verzekeraar"
  description="SCM/CCV-alarm laten inbouwen, klasse 2 t/m 5. Geaccepteerd door alle verzekeraars, zoals Centraal Beheer, Interpolis, Allianz en a.s.r. Inclusief montage en certificaat."
>
  <!-- Hero -->
  <section class="min-h-[60vh] bg-black text-white flex items-end pb-20 relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 w-full">
      <a href="/diensten/" class="inline-block text-gray-400 hover:text-white transition-colors text-sm mb-6 animate-fade-in-up">← Alle diensten</a>
      <p class="text-brand font-medium tracking-widest uppercase mb-4 animate-fade-in-up delay-100">Voertuigbeveiliging</p>
      <h1 class="heading-xl animate-fade-in-up delay-100" style="opacity: 0;">
        Alarmsysteem inbouwen<br />
        <span class="text-gray-500">goedgekeurd voor uw verzekeraar</span>
      </h1>
      <p class="text-xl text-gray-400 max-w-2xl mt-8 animate-fade-in-up delay-200" style="opacity: 0;">
        Eist uw verzekeraar een SCM-alarm of voertuigvolgsysteem? Wij bouwen het in, op locatie of in onze werkplaats, en u krijgt direct het SCM/CCV-certificaat dat uw verzekeraar vraagt. Vaste prijzen, ook ’s avonds en in het weekend.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-4 animate-fade-in-up delay-300">
        <a href="/contact/?dienst=alarmsystemen&check=1#formulier" class="inline-flex items-center justify-center gap-3 rounded-full bg-brand px-7 py-4 font-semibold text-white transition-all duration-300 hover:bg-white hover:text-black">Gratis klassecheck <span>→</span></a>
        <a href="tel:+31182796197" class="inline-flex items-center justify-center rounded-full border border-gray-700 px-7 py-4 font-semibold text-white transition-colors hover:border-brand hover:text-brand">Bel (0182) 79 61 97</a>
      </div>
      <a href="#verzekeraars" class="mt-6 inline-flex items-center gap-2 text-sm text-gray-400 hover:text-white transition-colors animate-fade-in-up delay-300">
        <svg class="w-4 h-4 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg>
        Geaccepteerd door alle Nederlandse verzekeraars
      </a>
    </div>
  </section>

  <!-- Welke klasse -->
  <section class="py-24 bg-gray-950">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="max-w-3xl reveal">
        <p class="text-brand font-medium tracking-widest uppercase mb-4">Welke klasse heeft u nodig?</p>
        <p class="text-xl text-gray-400 leading-relaxed">
          Voertuigbeveiliging is door <span class="text-white font-semibold">SCM/CCV</span> ingedeeld in klassen, van een alarm met inbraak- en omtrekbeveiliging tot een volledig gekoppeld voertuigvolgsysteem met 24/7 meldkamer. Welke klasse voor u verplicht of verstandig is, hangt af van uw voertuig en de eisen van uw verzekeraar. Als <span class="text-white font-semibold">SCM/CCV-erkend inbouwbedrijf</span> monteren wij op locatie of in onze werkplaats in Reeuwijk, inzetbaar door heel Nederland. Weet u het niet zeker? <span class="text-white font-semibold">Wij adviseren u vrijblijvend.</span>
        </p>
      </div>
    </div>
  </section>

  <!-- Verzekeraars & keurmerk: vertrouwen voor de verzekering -->
  <section id="verzekeraars" class="py-24 bg-black border-t border-white/10" style="scroll-margin-top:6rem">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="reveal grid grid-cols-1 lg:grid-cols-5 gap-10 lg:gap-14 items-start mb-12">
        <div class="lg:col-span-3">
          <p class="text-brand font-medium tracking-widest uppercase mb-4">Eist uw verzekeraar een SCM-alarm?</p>
          <h2 class="heading-lg mb-6">Alle verzekeraars<br /><span class="text-gray-500">keuren ons goed</span></h2>
          <p class="text-lg text-gray-400 leading-relaxed max-w-2xl">
            Wij zijn een <span class="text-white font-semibold">Kiwa SCM/CCV-erkend inbouwbedrijf</span>. Na elke inbouw ontvangt u een geldig SCM/CCV-certificaat, precies het bewijs dat alle Nederlandse autoverzekeraars vragen. Zo voldoet u direct aan uw polisvoorwaarden en bent u verzekerd tegen diefstal.
          </p>
        </div>
        <div class="lg:col-span-2 flex items-center justify-center lg:justify-end gap-8 lg:pt-10">
          <img src="/images/driehoek-CCV-voertuigbeveiliging-oranje.png" alt="CCV-keurmerk voor voertuigbeveiliging" class="h-24 md:h-28 w-auto object-contain" loading="lazy" />
          <span class="h-16 w-px bg-white/15"></span>
          <img src="/images/scm-logo-transparant.png" alt="SCM Secure Connected Mobility en Kiwa" class="h-12 md:h-14 w-auto object-contain" loading="lazy" />
        </div>
      </div>

      <div class="reveal">
        <Verzekeraars variant="full" />
      </div>

      <!-- Zo regelen wij het -->
      <div class="reveal mt-16">
        <h3 class="text-2xl font-bold mb-6">In drie stappen geregeld met uw verzekeraar</h3>
        <ol class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {[
            { t: 'Kies de juiste klasse', d: 'Weet u welke klasse uw verzekeraar eist? Bestel direct online. Twijfelt u, dan zoeken wij het gratis voor u uit, zodat u niet te veel en niet te weinig betaalt.' },
            { t: 'Inbouw binnen 24 uur gepland', d: 'Op locatie of in onze werkplaats in Reeuwijk, door heel Nederland. Ook ’s avonds en in het weekend, zodat u uw auto niet hoeft te missen.' },
            { t: 'Certificaat voor uw verzekeraar', d: 'Direct na de inbouw ontvangt u het SCM/CCV-certificaat. Dat stuurt u door naar uw verzekeraar en u voldoet aan de polis.' },
          ].map((stap, i) => (
            <li class="rounded-2xl bg-gray-950 ring-1 ring-white/10 p-6">
              <span class="flex items-center justify-center w-10 h-10 rounded-xl bg-brand/15 text-brand font-black mb-4">{i + 1}</span>
              <p class="text-lg font-bold mb-2">{stap.t}</p>
              <p class="text-sm text-gray-400 leading-relaxed">{stap.d}</p>
            </li>
          ))}
        </ol>
      </div>

      <!-- Urgentie, eerlijk geformuleerd -->
      <div class="reveal mt-6 flex flex-col sm:flex-row sm:items-center gap-4 rounded-2xl border border-amber-500/30 bg-amber-500/[0.06] px-6 py-5">
        <svg class="w-6 h-6 flex-none text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        <p class="text-gray-300 text-sm leading-relaxed"><span class="text-white font-semibold">Nieuwe auto gekocht?</span> Veel verzekeraars geven u na aanschaf maar een beperkte termijn om het vereiste alarm in te laten bouwen. Zonder geldig certificaat keert de verzekering bij diefstal mogelijk niet uit. Plan daarom op tijd.</p>
        <a href="tel:+31182796197" class="flex-none inline-flex items-center justify-center rounded-full bg-white text-black px-5 py-2.5 text-sm font-bold hover:bg-brand hover:text-white transition-colors">Bel direct</a>
      </div>
    </div>
  </section>

  <!-- Alarmsystemen -->
  <section class="py-24 bg-black">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="reveal">
        <p class="text-brand font-medium tracking-widest uppercase mb-4">Alarmsystemen</p>
        <h2 class="heading-lg mb-4">
          Alarm klasse 2<br />
          <span class="text-gray-500">en klasse 3</span>
        </h2>
        <p class="text-xl text-gray-400 mb-12 max-w-2xl">
          Vaste pakketprijs, inclusief btw, montage en SCM/CCV-certificaat. Direct online te bestellen.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {alarmPakketten.map((pakket) => (
          <div class={`reveal motion-card relative bg-gray-950 p-8 rounded-2xl ring-1 ${pakket.populair ? 'ring-2 ring-brand' : 'ring-white/10'} hover:ring-brand transition-all flex flex-col`}>
            {pakket.populair ? (
              <span class="absolute -top-3 left-8 bg-brand text-white text-xs font-bold uppercase tracking-wide px-3 py-1 rounded-full">Meest gekozen</span>
            ) : pakket.vanPrijs && (
              <span class="absolute -top-3 left-8 bg-white text-black text-xs font-bold uppercase tracking-wide px-3 py-1 rounded-full">Actie</span>
            )}
            <h3 class="text-2xl font-bold mb-1">{pakket.klasse}</h3>
            <p class="text-brand text-sm font-semibold mb-3">{pakket.sub}</p>
            <p class="text-gray-400 mb-6">{pakket.omschrijving}</p>
            <div class="flex items-baseline flex-wrap gap-x-3 gap-y-1 mb-1">
              <span class="text-4xl font-black text-white">{pakket.prijs}</span>
              {pakket.vanPrijs && <span class="text-lg text-gray-500 line-through">{pakket.vanPrijs}</span>}
            </div>
            <p class="text-gray-500 text-sm mb-6">Eenmalig, incl. btw en montage</p>
            <ul class="space-y-3 mb-8">
              {pakket.features.map((feature) => (
                <li class="flex items-center gap-3 text-gray-300">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand flex-shrink-0"></span>
                  {feature}
                </li>
              ))}
            </ul>
            {pakket.opmerking && (
              <p class="-mt-3 mb-6 text-xs text-brand bg-brand/10 ring-1 ring-brand/20 rounded-lg px-3 py-2.5 leading-snug">
                <span class="font-bold">Let op:</span> {pakket.opmerking}
              </p>
            )}
            {pakket.bestelLink ? (
              <a href={pakket.bestelLink} class="motion-button mt-auto inline-flex items-center justify-center gap-2 bg-brand text-white rounded-full px-6 py-3 font-semibold hover:bg-white hover:text-black transition-all">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                Bestel &amp; betaal
              </a>
            ) : (
              <a href="/contact/?dienst=alarmsystemen#formulier" class="mt-auto inline-flex items-center justify-center gap-2 border border-gray-700 text-white rounded-full px-6 py-3 font-semibold hover:border-brand hover:text-brand transition-colors">
                Offerte aanvragen
              </a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Voertuigvolgsystemen -->
  <section class="py-24 bg-gray-950">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="reveal">
        <p class="text-brand font-medium tracking-widest uppercase mb-4">Voertuigvolgsystemen</p>
        <h2 class="heading-lg mb-4">
          Klasse 4, 5 en<br />
          <span class="text-gray-500">terugvindsysteem</span>
        </h2>
        <p class="text-xl text-gray-400 mb-12 max-w-2xl">
          Vaste pakketprijs plus een jaarlijks abonnement op de meldkamer (PAC).
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {volgPakketten.map((pakket) => (
          <div class={`reveal motion-card relative bg-black p-8 rounded-2xl ring-1 ${pakket.populair ? 'ring-2 ring-brand' : 'ring-white/10'} hover:ring-brand transition-all flex flex-col`}>
            {pakket.populair ? (
              <span class="absolute -top-3 left-8 bg-brand text-white text-xs font-bold uppercase tracking-wide px-3 py-1 rounded-full">Meest gekozen</span>
            ) : pakket.vanPrijs && (
              <span class="absolute -top-3 left-8 bg-white text-black text-xs font-bold uppercase tracking-wide px-3 py-1 rounded-full">Actie</span>
            )}
            <h3 class="text-xl font-bold mb-1">{pakket.klasse}</h3>
            <p class="text-brand text-sm font-semibold mb-3">{pakket.sub}</p>
            <p class="text-gray-400 mb-6 text-sm">{pakket.omschrijving}</p>
            <div class="flex items-baseline flex-wrap gap-x-2.5 gap-y-1 mb-1">
              <span class="text-3xl font-black text-white">{pakket.prijs}</span>
              {pakket.vanPrijs && <span class="text-base text-gray-500 line-through">{pakket.vanPrijs}</span>}
            </div>
            <p class="text-gray-500 text-sm mb-6">eenmalig + {pakket.abonnement}</p>
            <ul class="space-y-3 mb-8">
              {pakket.features.map((feature) => (
                <li class="flex items-center gap-3 text-gray-300 text-sm">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand flex-shrink-0"></span>
                  {feature}
                </li>
              ))}
            </ul>
            {pakket.opmerking && (
              <p class="-mt-3 mb-6 text-xs text-brand bg-brand/10 ring-1 ring-brand/20 rounded-lg px-3 py-2.5 leading-snug">
                <span class="font-bold">Let op:</span> {pakket.opmerking}
              </p>
            )}
            {pakket.bestelLink ? (
              <a href={pakket.bestelLink} class="motion-button mt-auto inline-flex items-center justify-center gap-2 bg-brand text-white rounded-full px-6 py-3 font-semibold hover:bg-white hover:text-black transition-all">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                Bestel &amp; betaal
              </a>
            ) : (
              <a href="/contact/?dienst=alarmsystemen#formulier" class="mt-auto inline-flex items-center justify-center gap-2 border border-gray-700 text-white rounded-full px-6 py-3 font-semibold hover:border-brand hover:text-brand transition-colors">
                Offerte aanvragen
              </a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Uitleg per klasse -->
  <section class="py-24 bg-black">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="reveal flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-14">
        <div>
          <p class="text-brand font-medium tracking-widest uppercase mb-4">Uitleg</p>
          <h2 class="heading-lg">De alarmklassen<br /><span class="text-gray-500">in beeld</span></h2>
        </div>
        <div class="inline-flex items-center gap-4 self-start rounded-2xl bg-white/[0.04] ring-1 ring-white/10 px-5 py-3 backdrop-blur-sm">
          <img src="/images/scm-logo-transparant.png" alt="SCM / Kiwa erkend keurmerk" class="h-9 w-auto" loading="lazy" />
          <img src="/images/driehoek-CCV-voertuigbeveiliging-oranje.png" alt="CCV-keurmerk voertuigbeveiliging" class="h-9 w-auto" loading="lazy" />
          <span class="text-sm font-bold text-white leading-tight">Officieel<br />SCM/CCV-erkend</span>
        </div>
      </div>

      <div class="space-y-5 md:space-y-6">
        {klasseUitleg.map((item, i) => (
          <div class="reveal motion-card grid md:grid-cols-5 gap-6 md:gap-8 items-center rounded-2xl bg-gray-950 ring-1 ring-white/10 hover:ring-brand p-6 md:p-8 transition-all">
            <div class={`md:col-span-2 relative overflow-hidden rounded-xl bg-black/40 ring-1 ring-white/5 flex items-center justify-center p-4 min-h-[180px] ${i % 2 ? 'md:order-2' : ''}`}>
