---
import Layout from '../layouts/Layout.astro';

// Alarmsystemen — eenmalige prijs, incl. btw, montage en SCM/CCV-certificaat
const alarmPakketten = [
  {
    klasse: 'Klasse 2',
    prijs: '€849',
    handzender: '€899',
    populair: false,
    omschrijving: 'Startonderbreker met inbraak- en omtrekbeveiliging.',
    features: [
      'SCM/CCV-certificaat',
      'Startonderbreker',
      'Radardetectie en omtrekbeveiliging',
      'Noodstroomsirene',
    ],
  },
  {
    klasse: 'Klasse 3',
    prijs: '€999',
    handzender: '€1.049',
    populair: false,
    omschrijving: 'Klasse 2, uitgebreid met hellingshoekdetectie tegen wegslepen.',
    features: [
      'SCM/CCV-certificaat',
      'Startonderbreker',
      'Radardetectie en omtrekbeveiliging',
      'Hellingshoekdetectie',
      'Noodstroomsirene',
    ],
  },
];

// Voertuigvolgsystemen — eenmalige prijs + jaarlijks meldkamerabonnement (PAC)
const volgPakketten = [
  {
    klasse: 'Klasse 4',
    prijs: '€699',
    abonnement: '€275 per jaar',
    populair: false,
    omschrijving: 'Voertuigvolgsysteem met 24/7 meldkamer en jammingdetectie.',
    features: [
      'SCM/CCV-certificaat',
      'Voertuigvolgsysteem',
      'Startblokkade op afstand',
      '24/7 meldkamer',
      'Jammingdetectie',
    ],
  },
  {
    klasse: 'Klasse 5',
    prijs: '€799',
    abonnement: '€275 per jaar',
    populair: true,
    omschrijving: 'Het complete systeem: alarm én voertuigvolgsysteem met pushmelding.',
    features: [
      'SCM/CCV-certificaat',
      'Alarm gekoppeld aan voertuigvolgsysteem',
      'Startblokkade op afstand',
      '24/7 meldkamer',
      'Jammingdetectie',
      'Pushmelding bij alarm',
    ],
  },
  {
    klasse: 'Klasse TV — terugvindsysteem',
    prijs: '€299',
    abonnement: '€99 per jaar',
    populair: false,
    omschrijving: 'Compact terugvindsysteem om uw voertuig na diefstal te traceren.',
    features: [
      'SCM/CCV-certificaat',
      'Terugvindsysteem',
      '24/7 meldkamer',
    ],
  },
];

// Uitleg per klasse — extra tekst voor zoekmachines en bezoekers
const klasseUitleg = [
  {
    naam: 'Alarm klasse 2',
    tekst: 'Een SCM/CCV alarm klasse 2 combineert een startonderbreker met inbraak- en omtrekbeveiliging. Sensoren detecteren beweging in en rond het voertuig en activeren de noodstroomsirene. Dit is de instap voor een volwaardig auto-alarm en vaak voldoende wanneer uw verzekeraar een alarm eist zonder hellingshoekdetectie.',
  },
  {
    naam: 'Alarm klasse 3',
    tekst: 'Een alarm klasse 3 heeft alles van klasse 2 en voegt hellingshoekdetectie toe. Probeert een dief uw voertuig op te krikken of weg te slepen, dan gaat het alarm af. Klasse 3 is de meest gevraagde klasse door verzekeraars en beschermt dankzij eigen autorisatie ook tegen keyless diefstal (de relay attack).',
  },
  {
    naam: 'Klasse 4 — voertuigvolgsysteem',
    tekst: 'Een klasse 4 voertuigvolgsysteem is een SCM/CCV-gecertificeerd track & trace systeem met aansluiting op een 24/7 meldkamer. Bij diefstal wordt uw voertuig via GPS gevolgd en kan het op afstand worden geblokkeerd. Jammingdetectie merkt het direct wanneer iemand het signaal probeert te verstoren.',
  },
  {
    naam: 'Klasse 5 — alarm én volgsysteem gekoppeld',
    tekst: 'Klasse 5 is de meest complete oplossing: een alarm gekoppeld aan een voertuigvolgsysteem. Gaat het alarm af, dan ontvangen u én de meldkamer direct een pushmelding, zodat er meteen actie ondernomen kan worden. U combineert zo afschrikking, tracking en opvolging in één systeem.',
  },
  {
    naam: 'Klasse TV — terugvindsysteem',
    tekst: 'Het klasse TV terugvindsysteem is een compacte, SCM/CCV-gecertificeerde tracker waarmee uw voertuig na diefstal snel wordt teruggevonden via de meldkamer. Een voordelige oplossing met een laag jaarabonnement, ideaal als aanvulling of voor voertuigen met een lager risicoprofiel.',
  },
];

// Veelgestelde vragen — vangt long-tail zoekopdrachten en voedt de FAQ-structuurdata
const faqs = [
  {
    vraag: 'Is een SCM-alarm verplicht?',
    antwoord: 'Dat hangt af van uw verzekeraar en voertuig. Bij nieuwere of duurdere voertuigen eist de verzekeraar vaak een SCM/CCV-goedgekeurd alarm (meestal klasse 3) of een voertuigvolgsysteem (klasse 4 of 5). Wij adviseren u vrijblijvend welke klasse in uw situatie nodig is.',
  },
  {
    vraag: 'Wat is het verschil tussen klasse 2 en klasse 3?',
    antwoord: 'Beide hebben een startonderbreker en inbraakdetectie. Klasse 3 voegt hellingshoekdetectie toe, waardoor het alarm ook afgaat bij wegslepen of opkrikken. Daarom vragen verzekeraars meestal om klasse 3.',
  },
  {
    vraag: 'Wat is het verschil tussen klasse 4 en klasse 5?',
    antwoord: 'Klasse 4 is een voertuigvolgsysteem dat los staat van het alarm. Bij klasse 5 is het volgsysteem gekoppeld aan een alarm, zodat een alarmmelding automatisch doorgaat naar de meldkamer, met een pushmelding naar u.',
  },
  {
    vraag: 'Wat kost een alarmsysteem inbouwen?',
    antwoord: 'Onze vanaf-prijzen: klasse 2 vanaf €849, klasse 3 vanaf €999, klasse 4 vanaf €699 en klasse 5 vanaf €799, inclusief btw, montage en SCM/CCV-certificaat. Bij de voertuigvolgsystemen (klasse 4, 5 en het terugvindsysteem) komt een jaarlijks meldkamerabonnement. De definitieve prijs hangt af van merk, model en bouwjaar.',
  },
  {
    vraag: 'Helpt het tegen keyless diefstal (relay attack)?',
    antwoord: 'Ja. Onze systemen werken met eigen autorisatie, waardoor het verlengen van het sleutelsignaal (de relay attack) geen toegang meer geeft tot het starten of wegrijden van uw voertuig.',
  },
  {
    vraag: 'Komen jullie op locatie en krijg ik een certificaat?',
    antwoord: 'Ja, wij bouwen op locatie of in onze werkplaats in Reeuwijk in en zijn inzetbaar door heel Nederland. Na de installatie ontvangt u een geldig SCM/CCV-certificaat.',
  },
];

// FAQ-structuurdata (schema.org) — helpt Google de vraag-en-antwoorden te begrijpen
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.vraag,
    acceptedAnswer: { '@type': 'Answer', text: f.antwoord },
  })),
};
---

<Layout
  title="Alarmsysteem inbouwen: SCM/CCV klasse 2 t/m 5 — prijzen"
  description="SCM/CCV-alarmsystemen en voertuigvolgsystemen (klasse 2 t/m 5 en terugvindsysteem) professioneel ingebouwd, inclusief montage en certificaat. Bekijk de prijzen."
>
  <!-- Hero -->
  <section class="min-h-[60vh] bg-black text-white flex items-end pb-20 relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 w-full">
      <p class="text-brand font-medium tracking-widest uppercase mb-4 animate-fade-in-up">Voertuigbeveiliging</p>
      <h1 class="heading-xl animate-fade-in-up delay-100" style="opacity: 0;">
        Alarmsysteem inbouwen<br />
        <span class="text-gray-500">met SCM/CCV-certificaat</span>
      </h1>
      <p class="text-xl text-gray-400 max-w-2xl mt-8 animate-fade-in-up delay-200" style="opacity: 0;">
        SCM/CCV-gecertificeerde alarmsystemen en voertuigvolgsystemen (klasse 2 t/m 5), professioneel ingebouwd op locatie of in onze werkplaats. Bekijk hieronder de klassen en prijzen.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-4 animate-fade-in-up delay-300">
        <a href="/contact/?dienst=alarmsystemen#formulier" class="inline-flex items-center justify-center gap-3 rounded-full bg-brand px-7 py-4 font-semibold text-white transition-all duration-300 hover:bg-white hover:text-black">Vraag advies over uw voertuig <span>→</span></a>
        <a href="tel:+31182796197" class="inline-flex items-center justify-center rounded-full border border-gray-700 px-7 py-4 font-semibold text-white transition-colors hover:border-brand hover:text-brand">Bel (0182) 79 61 97</a>
      </div>
    </div>
  </section>

  <!-- Welke klasse -->
  <section class="py-24 bg-gray-950">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="max-w-3xl reveal">
        <p class="text-brand font-medium tracking-widest uppercase mb-4">Welke klasse heeft u nodig?</p>
        <p class="text-xl text-gray-400 leading-relaxed">
          Voertuigbeveiliging is door <span class="text-white font-semibold">SCM/CCV</span> ingedeeld in klassen, van een alarm met inbraak- en omtrekbeveiliging tot een volledig gekoppeld voertuigvolgsysteem met 24/7 meldkamer. Welke klasse voor u verplicht of verstandig is, hangt af van uw voertuig en de eisen van uw verzekeraar. Als <span class="text-white font-semibold">SCM/CCV-erkend inbouwbedrijf</span> monteren wij op locatie of in onze werkplaats in Reeuwijk, inzetbaar door heel Nederland. Weet u het niet zeker? <span class="text-white font-semibold">Wij adviseren u vrijblijvend.</span>
        </p>
      </div>
    </div>
  </section>

  <!-- Certificering en keurmerken -->
  <section class="py-20 bg-black">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="reveal mb-10 max-w-3xl">
        <p class="text-brand font-medium tracking-widest uppercase mb-4">Kennis en kwaliteit</p>
        <h2 class="heading-lg">Erkende voertuigbeveiliging</h2>
        <p class="text-lg text-gray-400 mt-5">Wij helpen u met een beveiligingsoplossing die past bij uw voertuig en de eisen van uw verzekeraar.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 max-w-4xl">
        <figure class="reveal motion-card rounded-2xl border border-gray-800 bg-gray-950 p-5">
          <div class="flex h-36 items-center justify-center rounded-xl bg-white p-5">
            <img src="/images/SCM-logo-Kiwa-kleuren-ONDERTITEL.jpg" alt="SCM Secure Connected Mobility en Kiwa" class="max-h-full w-full object-contain" loading="lazy" />
          </div>
          <figcaption class="mt-4 text-sm text-gray-300">SCM en Kiwa</figcaption>
        </figure>
        <figure class="reveal motion-card rounded-2xl border border-gray-800 bg-gray-950 p-5">
          <div class="flex h-36 items-center justify-center rounded-xl bg-white p-5">
            <img src="/images/driehoek-CCV-voertuigbeveiliging-oranje.png" alt="CCV-keurmerk voor voertuigbeveiliging" class="max-h-full w-auto object-contain" loading="lazy" />
          </div>
          <figcaption class="mt-4 text-sm text-gray-300">CCV voertuigbeveiliging</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Alarmsystemen -->
  <section class="py-24 bg-black">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="reveal">
        <p class="text-brand font-medium tracking-widest uppercase mb-4">Alarmsystemen</p>
        <h2 class="heading-lg mb-4">
          Alarm klasse 2<br />
          <span class="text-gray-500">en klasse 3</span>
        </h2>
        <p class="text-xl text-gray-400 mb-12 max-w-2xl">
          Eenmalige prijs, inclusief btw, montage en SCM/CCV-certificaat.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {alarmPakketten.map((pakket) => (
          <div class={`reveal motion-card relative bg-gray-950 p-8 border ${pakket.populair ? 'border-brand' : 'border-gray-800'} hover:border-brand transition-colors flex flex-col`}>
            {pakket.populair && (
              <span class="absolute -top-3 left-8 bg-brand text-white text-xs font-bold uppercase tracking-wide px-3 py-1">Meest gekozen</span>
            )}
            <h3 class="text-2xl font-bold mb-2">{pakket.klasse}</h3>
            <p class="text-gray-400 mb-6">{pakket.omschrijving}</p>
            <div class="flex items-baseline gap-2 mb-1">
              <span class="text-gray-500 text-sm">vanaf</span>
              <span class="text-4xl font-black text-white">{pakket.prijs}</span>
            </div>
            <p class="text-gray-500 text-sm mb-6">Met losse handzender: {pakket.handzender}</p>
            <ul class="space-y-3 mb-8">
              {pakket.features.map((feature) => (
                <li class="flex items-center gap-3 text-gray-300">
                  <span class="w-2 h-2 bg-brand flex-shrink-0"></span>
                  {feature}
                </li>
              ))}
            </ul>
            <a href="/contact/?dienst=alarmsystemen#formulier" class="mt-auto inline-flex items-center justify-center gap-2 border border-gray-700 text-white rounded-full px-6 py-3 font-semibold hover:border-brand hover:text-brand transition-colors">
              Offerte aanvragen
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Voertuigvolgsystemen -->
  <section class="py-24 bg-gray-950">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="reveal">
        <p class="text-brand font-medium tracking-widest uppercase mb-4">Voertuigvolgsystemen</p>
        <h2 class="heading-lg mb-4">
          Klasse 4, 5 en<br />
          <span class="text-gray-500">terugvindsysteem</span>
        </h2>
        <p class="text-xl text-gray-400 mb-12 max-w-2xl">
          Eenmalige prijs plus een jaarlijks abonnement op de meldkamer (PAC).
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {volgPakketten.map((pakket) => (
          <div class={`reveal motion-card relative bg-black p-8 border ${pakket.populair ? 'border-brand' : 'border-gray-800'} hover:border-brand transition-colors flex flex-col`}>
            {pakket.populair && (
              <span class="absolute -top-3 left-8 bg-brand text-white text-xs font-bold uppercase tracking-wide px-3 py-1">Meest gekozen</span>
            )}
            <h3 class="text-xl font-bold mb-2">{pakket.klasse}</h3>
            <p class="text-gray-400 mb-6 text-sm">{pakket.omschrijving}</p>
            <div class="flex items-baseline gap-2 mb-1">
              <span class="text-gray-500 text-sm">vanaf</span>
              <span class="text-3xl font-black text-white">{pakket.prijs}</span>
            </div>
            <p class="text-gray-500 text-sm mb-6">+ {pakket.abonnement}</p>
            <ul class="space-y-3 mb-8">
              {pakket.features.map((feature) => (
                <li class="flex items-center gap-3 text-gray-300 text-sm">
                  <span class="w-2 h-2 bg-brand flex-shrink-0"></span>
                  {feature}
                </li>
              ))}
            </ul>
            <a href="/contact/?dienst=alarmsystemen#formulier" class="mt-auto inline-flex items-center justify-center gap-2 border border-gray-700 text-white rounded-full px-6 py-3 font-semibold hover:border-brand hover:text-brand transition-colors">
              Offerte aanvragen
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Uitleg per klasse -->
  <section class="py-24 bg-black">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="reveal">
        <p class="text-brand font-medium tracking-widest uppercase mb-4">Uitleg</p>
        <h2 class="heading-lg mb-12">
          De alarmklassen<br />
          <span class="text-gray-500">uitgelegd</span>
        </h2>
      </div>

      <div class="max-w-3xl space-y-8">
        {klasseUitleg.map((item) => (
          <div class="reveal border-t border-gray-800 pt-8">
            <h3 class="text-2xl font-bold mb-3">{item.naam}</h3>
            <p class="text-lg text-gray-400 leading-relaxed">{item.tekst}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Goed om te weten -->
  <section class="py-24 bg-gray-950">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="max-w-3xl reveal">
        <p class="text-brand font-medium tracking-widest uppercase mb-4">Goed om te weten</p>
        <ul class="space-y-4">
          <li class="flex items-start gap-4 text-xl text-gray-300">
            <span class="text-brand text-2xl leading-none">✓</span>
            Alle prijzen zijn inclusief btw, montage en SCM/CCV-certificaat.
          </li>
          <li class="flex items-start gap-4 text-xl text-gray-300">
            <span class="text-brand text-2xl leading-none">✓</span>
            Het zijn vanaf-prijzen. De definitieve prijs hangt af van merk, model en bouwjaar, bijvoorbeeld bij een dubbele startblokkering of wanneer er LED-verlichting moet worden aangestuurd.
          </li>
          <li class="flex items-start gap-4 text-xl text-gray-300">
            <span class="text-brand text-2xl leading-none">✓</span>
            Het jaarbedrag bij de volgsystemen is het abonnement op de particuliere alarmcentrale (PAC), die uw voertuig 24/7 in de gaten houdt.
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Veelgestelde vragen -->
  <section class="py-24 bg-black">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="reveal">
        <p class="text-brand font-medium tracking-widest uppercase mb-4">Veelgestelde vragen</p>
        <h2 class="heading-lg mb-12">
          Veelgestelde vragen<br />
          <span class="text-gray-500">over alarmsystemen</span>
        </h2>
      </div>

      <div class="max-w-3xl space-y-8">
        {faqs.map((f) => (
          <div class="reveal border-t border-gray-800 pt-8">
            <h3 class="text-xl md:text-2xl font-bold mb-3">{f.vraag}</h3>
            <p class="text-lg text-gray-400 leading-relaxed">{f.antwoord}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section id="contact" class="py-32 bg-brand text-white scroll-mt-24">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center reveal">
      <h2 class="heading-lg mb-8">
        Benieuwd wat het<br />voor uw voertuig kost?
      </h2>
      <p class="text-xl text-white/80 mb-12 max-w-xl mx-auto">
        Stuur ons het merk, type, bouwjaar en kenteken, dan maken wij een passend voorstel. We zijn inzetbaar door heel Nederland.
      </p>
      <a
        href="/contact/?dienst=alarmsystemen#formulier"
        class="group inline-flex items-center gap-3 bg-white text-brand rounded-full px-10 py-5 text-xl font-bold hover:bg-black hover:text-white transition-all duration-300"
      >
        Vraag een offerte aan
        <span class="group-hover:translate-x-2 transition-transform duration-300">→</span>
      </a>
      <div class="mt-12 text-white/80">
        <p class="text-lg"><a href="tel:+31182796197" class="hover:text-white transition-colors">📞 (0182) 79 61 97</a></p>
        <p class="text-lg"><a href="mailto:info@scharloo-install.nl" class="hover:text-white transition-colors">✉ info@scharloo-install.nl</a></p>
      </div>
    </div>
  </section>
</Layout>

<!-- FAQ-structuurdata voor zoekmachines -->
<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

<script>
  const reveals = document.querySelectorAll('.reveal');

  const revealOnScroll = () => {
    reveals.forEach(el => {
      const top = el.getBoundingClientRect().top;
      if (top < window.innerHeight - 100) {
        el.classList.add('active');
      }
    });
  };

  window.addEventListener('scroll', revealOnScroll);
  revealOnScroll();
</script>
