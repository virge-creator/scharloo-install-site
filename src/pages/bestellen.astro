---
import Layout from '../layouts/Layout.astro';
import { diensten, dienstUrl } from '../data/diensten';

// Online bestelbaar: diensten met een vaste prijs, behalve dashcams (nog finetunen).
const bestelbaar = diensten.filter((d) => d.prijzen.length > 0 && d.slug !== 'dashcams');

const stappen = [
  { titel: 'Kies uw dienst', tekst: 'Selecteer de dienst die u wilt en reken direct veilig online af.' },
  { titel: 'Betaal met iDEAL', tekst: 'Snel en vertrouwd betalen via iDEAL, creditcard of Apple/Google Pay.' },
  { titel: 'Wij plannen uw afspraak', tekst: 'Binnen 3 werkdagen nemen wij contact op om de inbouwafspraak in te plannen.' },
];
---

<Layout
  title="Online bestellen & betalen"
  description="Bestel uw dienst van Scharloo-Install direct online en reken veilig af via iDEAL. Wij nemen binnen 3 werkdagen contact op om uw inbouwafspraak te plannen."
>
  <!-- Hero -->
  <section class="relative bg-black text-white overflow-hidden pt-28 pb-16 md:pt-36 md:pb-20">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8">
      <p class="text-brand font-medium tracking-widest uppercase mb-4 animate-fade-in-up">Online bestellen</p>
      <h1 class="heading-xl animate-fade-in-up delay-100" style="opacity: 0;">
        Direct regelen,<br />
        <span class="text-brand">veilig</span> betaald
      </h1>
      <p class="text-xl text-gray-300 max-w-2xl mt-8 animate-fade-in-up delay-200" style="opacity: 0;">
        Bestel uw dienst online en reken in één keer af via iDEAL. Daarna nemen wij binnen 3 werkdagen contact op om uw inbouwafspraak in te plannen.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-gray-400 animate-fade-in-up delay-300">
        <span class="inline-flex items-center gap-2"><svg class="w-4 h-4 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg>Veilig betalen via Stripe</span>
        <span class="inline-flex items-center gap-2"><svg class="w-4 h-4 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m9 12 2 2 4-4"/></svg>iDEAL, creditcard & meer</span>
        <span class="inline-flex items-center gap-2"><svg class="w-4 h-4 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>Binnen 3 werkdagen contact</span>
      </div>
    </div>
  </section>

  <!-- Bestelbare diensten -->
  <section class="py-20 md:py-24 bg-gray-950 border-t border-white/10">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6">
        {bestelbaar.map((d) => {
          const p = d.prijzen[0];
          const heeftLink = !!d.bestelLink;
          // Maatwerk (prijs afhankelijk van merk/model) is niet direct afrekenbaar.
          const opAanvraag = d.slug === 'trekhaken';
          const aanvraagLabel = opAanvraag ? 'Prijs aanvragen' : 'Direct aanvragen';
          return (
            <div class="motion-card reveal rounded-2xl bg-black ring-1 ring-white/10 hover:ring-brand p-7 md:p-8 flex flex-col transition-all">
              <div class="flex items-start justify-between gap-4 mb-4">
                <div>
                  <h2 class="text-2xl font-bold">{d.title}</h2>
                  <p class="text-brand/80 text-sm font-medium mt-1">{d.subtitle}</p>
                </div>
                <div class="text-right flex-shrink-0">
                  <p class="text-gray-500 text-xs uppercase tracking-widest">vanaf</p>
                  <p class="text-3xl font-black text-white leading-none mt-1">{p.prijs}</p>
                </div>
              </div>
              <p class="text-gray-400 text-sm leading-relaxed mb-2">{d.kort}</p>
              {p.detail && <p class="text-gray-500 text-xs mb-6">{p.detail}</p>}
              {p.maand && (
                <p class="text-gray-500 text-xs mb-6">Daarna <span class="text-gray-300 font-semibold">{p.maand} p/m</span> via automatische incasso, direct geregeld bij uw bestelling.</p>
              )}

              <div class="mt-auto flex flex-col sm:flex-row gap-3">
                {heeftLink && !opAanvraag ? (
                  <a href={d.bestelLink} target="_blank" rel="noopener" class="motion-button flex-1 inline-flex items-center justify-center gap-2 bg-brand text-white rounded-full px-6 py-3.5 font-semibold hover:bg-white hover:text-black transition-all duration-300">
                    Bestel &amp; betaal
                    <span>→</span>
                  </a>
                ) : (
                  <a href={`/contact/?dienst=${d.slug}#formulier`} class="motion-button flex-1 inline-flex items-center justify-center gap-2 bg-brand text-white rounded-full px-6 py-3.5 font-semibold hover:bg-white hover:text-black transition-all duration-300">
                    {aanvraagLabel}
                    <span>→</span>
                  </a>
                )}
                <a href={dienstUrl(d)} class="inline-flex items-center justify-center rounded-full border border-white/20 text-white px-6 py-3.5 font-semibold hover:border-brand hover:text-brand transition-colors">
                  Meer info
                </a>
              </div>
            </div>
          );
        })}
      </div>

      <p class="text-center text-gray-500 text-sm mt-10 reveal">
        Staat uw dienst er niet bij, of wilt u maatwerk? <a href="/contact/#formulier" class="text-brand hover:text-white transition-colors font-semibold">Neem contact op</a> voor een offerte op maat.
      </p>
    </div>
  </section>

  <!-- Hoe het werkt -->
  <section class="py-20 md:py-24 bg-black">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="reveal max-w-2xl mb-14">
        <p class="text-brand font-medium tracking-widest uppercase mb-4">Hoe het werkt</p>
        <h2 class="heading-lg">In 3 stappen<br /><span class="text-gray-500">geregeld</span></h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6">
        {stappen.map((s, i) => (
          <div class="reveal rounded-2xl bg-gray-950 ring-1 ring-white/10 p-7">
            <span class="flex items-center justify-center w-11 h-11 rounded-xl bg-brand/15 text-brand font-black mb-5">{i + 1}</span>
            <h3 class="text-xl font-bold mb-2">{s.titel}</h3>
            <p class="text-gray-400 text-sm leading-relaxed">{s.tekst}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 bg-brand text-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center reveal">
      <h2 class="heading-lg mb-6">Vragen voor u bestelt?</h2>
      <p class="text-xl text-white/80 mb-10 max-w-xl mx-auto">We helpen u graag met het kiezen van de juiste dienst voor uw voertuig.</p>
      <a href="/contact/#formulier" class="group inline-flex items-center gap-3 bg-white text-brand rounded-full px-10 py-5 text-xl font-bold hover:bg-black hover:text-white transition-all duration-300">
        Stel uw vraag
        <span class="group-hover:translate-x-2 transition-transform duration-300">→</span>
      </a>
    </div>
  </section>
</Layout>

<script>
  const reveals = document.querySelectorAll('.reveal');
  const onScroll = () => reveals.forEach((el) => { if (el.getBoundingClientRect().top < window.innerHeight - 80) el.classList.add('active'); });
  window.addEventListener('scroll', onScroll);
  onScroll();
</script>
