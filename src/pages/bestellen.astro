---
import Layout from '../layouts/Layout.astro';
import { diensten, dienstUrl } from '../data/diensten';
import { alarmPakketten, volgPakketten } from '../data/alarm.ts';

// Alarm- en voertuigvolgpakketten samen in één shop-grid.
const beveiliging = [...alarmPakketten, ...volgPakketten];

// Online bestelbaar: diensten met een vaste prijs, behalve dashcams (nog finetunen).
const bestelbaar = diensten.filter((d) => d.prijzen.length > 0 && d.slug !== 'dashcams');

// Productfoto per dienst voor de shop-kaarten. Heeft een dienst hier geen foto,
// dan toont de kaart automatisch een nette branded icoon-tegel.
const kaartFoto: Record<string, string> = {
  'voertuigvolgsystemen': '/images/eco5-tracker.png',
  'gps-startonderbreker': '/images/eco5-startonderbreker.png',
  'target-blu-eye': '/images/blu-eye-2-set-transparant.png',
  'trekhaken': '/images/590000-transparant.png',
};

// Icoon per dienst (fallback als er geen foto is).
const dienstIconen: Record<string, string> = {
  'voertuigvolgsystemen': '<path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0Z"/><circle cx="12" cy="10" r="3"/>',
  'gps-startonderbreker': '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><rect x="9.5" y="11" width="5" height="4.5" rx="1"/><path d="M10.2 11V9.6a1.8 1.8 0 0 1 3.6 0V11"/>',
  'target-blu-eye': '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>',
  'trekhaken': '<circle cx="12" cy="5" r="2"/><path d="M12 7v4l-5 6"/><rect x="3" y="17" width="18" height="4" rx="1"/>',
};
const standaardIcoon = '<circle cx="12" cy="12" r="9"/><path d="m9 12 2 2 4-4"/>';

const stappen = [
  { titel: 'Kies uw dienst', tekst: 'Selecteer de dienst die u wilt en reken direct veilig online af.' },
  { titel: 'Betaal met iDEAL', tekst: 'Snel en vertrouwd betalen via iDEAL, creditcard of Apple/Google Pay.' },
  { titel: 'Afspraak ingepland', tekst: 'Binnen 24 uur plannen wij samen met u de inbouwafspraak in.' },
];
---

<Layout
  title="Online bestellen & betalen"
  description="Bestel uw dienst van Scharloo-Install direct online en reken veilig af via iDEAL. Wij nemen binnen 24 uur contact op om uw inbouwafspraak te plannen."
>
  <!-- Hero -->
  <section class="relative bg-black text-white overflow-hidden pt-28 pb-16 md:pt-36 md:pb-20">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8">
      <p class="text-brand font-medium tracking-widest uppercase mb-4 animate-fade-in-up">Online bestellen</p>
      <h1 class="heading-xl animate-fade-in-up delay-100" style="opacity: 0;">
        Direct regelen,<br />
        <span class="text-brand">veilig</span> betaald
      </h1>
      <p class="text-xl text-gray-300 max-w-2xl mt-8 animate-fade-in-up delay-200" style="opacity: 0;">
        Kies uw dienst, reken in één keer af via iDEAL, en wij plannen binnen 24 uur uw inbouwafspraak in.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-gray-400 animate-fade-in-up delay-300">
        <span class="inline-flex items-center gap-2"><svg class="w-4 h-4 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg>Veilig betalen via Stripe</span>
        <span class="inline-flex items-center gap-2"><svg class="w-4 h-4 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m9 12 2 2 4-4"/></svg>iDEAL, creditcard & meer</span>
        <span class="inline-flex items-center gap-2"><svg class="w-4 h-4 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>Binnen 24 uur ingepland</span>
      </div>
    </div>
  </section>

  <!-- Bestelbare diensten (shop) -->
  <section class="py-20 md:py-24 bg-gray-950 border-t border-white/10">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
        {bestelbaar.map((d) => {
          const p = d.prijzen[0];
          const heeftLink = !!d.bestelLink;
          // Maatwerk (prijs afhankelijk van merk/model) is niet direct afrekenbaar.
          const opAanvraag = d.slug === 'trekhaken';
          const aanvraagLabel = opAanvraag ? 'Prijs aanvragen' : 'Direct aanvragen';
          const foto = kaartFoto[d.slug];
          return (
            <div class="motion-card reveal group rounded-2xl bg-black ring-1 ring-white/10 hover:ring-brand overflow-hidden flex flex-col transition-all">
              {/* Foto / icoon-tegel */}
              <div class="relative h-48 bg-gradient-to-br from-brand/20 via-white/[0.03] to-transparent flex items-center justify-center border-b border-white/10">
                {p.vanPrijs && (
                  <span class="absolute top-3 left-3 z-10 rounded-full bg-brand text-white text-[11px] font-bold uppercase tracking-wide px-3 py-1 shadow-lg shadow-brand/30">Actie</span>
                )}
                {foto ? (
                  <img src={foto} alt={d.title} loading="lazy" class="max-h-40 w-auto object-contain p-4 transition-transform duration-500 group-hover:scale-105" />
                ) : (
                  <span class="flex items-center justify-center w-20 h-20 rounded-2xl bg-brand/15 text-brand ring-1 ring-brand/30">
                    <svg class="w-10 h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={dienstIconen[d.slug] || standaardIcoon}></svg>
                  </span>
                )}
              </div>

              {/* Body */}
              <div class="p-6 md:p-7 flex flex-col flex-1">
                <h2 class="text-xl font-bold">{d.title}</h2>
                <p class="text-brand/80 text-sm font-medium mt-1 mb-3">{d.subtitle}</p>
                <p class="text-gray-400 text-sm leading-relaxed mb-5">{d.kort}</p>

                <div class="mt-auto">
                  <div class="flex items-baseline gap-2">
                    {p.vanPrijs && <span class="text-gray-500 text-base line-through decoration-brand/60">{p.vanPrijs}</span>}
                    <span class="text-3xl font-black text-white leading-none">{p.prijs}</span>
                  </div>
                  {p.detail && <p class="text-gray-500 text-xs mt-1.5">{p.detail}</p>}
                  {p.maand && (
                    <p class="text-gray-500 text-xs mt-1">Daarna <span class="text-gray-300 font-semibold">{p.maand} p/m</span> via automatische incasso.</p>
                  )}

                  <div class="mt-5 flex flex-col gap-2.5">
                    {heeftLink && !opAanvraag ? (
                      <a href={d.bestelLink} target="_blank" rel="noopener" class="motion-button inline-flex items-center justify-center gap-2 bg-brand text-white rounded-full px-6 py-3.5 font-semibold hover:bg-white hover:text-black transition-all duration-300">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                        Bestel &amp; betaal
                      </a>
                    ) : (
                      <a href={`/contact/?dienst=${d.slug}#formulier`} class="motion-button inline-flex items-center justify-center gap-2 bg-brand text-white rounded-full px-6 py-3.5 font-semibold hover:bg-white hover:text-black transition-all duration-300">
                        {aanvraagLabel}
                        <span>→</span>
                      </a>
                    )}
                    <a href={dienstUrl(d)} class="inline-flex items-center justify-center rounded-full border border-white/20 text-white px-6 py-3 font-semibold hover:border-brand hover:text-brand transition-colors">
                      Meer info
                    </a>
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <p class="text-center text-gray-500 text-sm mt-10 reveal">
        Staat uw dienst er niet bij, of wilt u maatwerk? <a href="/contact/#formulier" class="text-brand hover:text-white transition-colors font-semibold">Neem contact op</a> voor een offerte op maat.
      </p>
    </div>
  </section>

  <!-- Alarmsystemen & beveiliging (shop) -->
  <section class="py-20 md:py-24 bg-black border-t border-white/10">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="reveal flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12">
        <div class="max-w-2xl">
          <p class="text-brand font-medium tracking-widest uppercase mb-4">Alarmsystemen &amp; beveiliging</p>
          <h2 class="heading-lg mb-4">SCM/CCV-pakketten<br /><span class="text-gray-500">met vaste prijs</span></h2>
          <p class="text-lg text-gray-400">Vaste pakketprijs, inclusief btw, montage en SCM/CCV-certificaat. Bij de voertuigvolgsystemen komt een jaarlijks meldkamerabonnement.</p>
        </div>
        <div class="inline-flex items-center gap-3 self-start rounded-2xl bg-white ring-1 ring-white/10 px-5 py-3 shadow-xl shadow-black/40">
          <img src="/images/SCM-logo-Kiwa-kleuren-ONDERTITEL.jpg" alt="SCM / Kiwa erkend keurmerk" class="h-9 w-auto" loading="lazy" />
          <span class="text-sm font-bold text-gray-900 leading-tight">Officieel<br />SCM/CCV-erkend</span>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
        {beveiliging.map((pakket) => (
          <div class="motion-card reveal group rounded-2xl bg-gray-950 ring-1 ring-white/10 hover:ring-brand overflow-hidden flex flex-col transition-all">
            {/* Foto-tegel */}
            <div class="relative h-48 bg-gradient-to-br from-brand/20 via-white/[0.03] to-transparent flex items-center justify-center border-b border-white/10">
              {pakket.populair ? (
                <span class="absolute top-3 left-3 z-10 rounded-full bg-brand text-white text-[11px] font-bold uppercase tracking-wide px-3 py-1 shadow-lg shadow-brand/30">Meest gekozen</span>
              ) : pakket.vanPrijs && (
                <span class="absolute top-3 left-3 z-10 rounded-full bg-white text-black text-[11px] font-bold uppercase tracking-wide px-3 py-1 shadow-lg">Actie</span>
              )}
              <img src={pakket.foto} alt={`${pakket.klasse} - ${pakket.sub}`} loading="lazy" class="max-h-40 w-auto object-contain p-4 transition-transform duration-500 group-hover:scale-105" />
            </div>

            {/* Body */}
            <div class="p-6 md:p-7 flex flex-col flex-1">
              <h3 class="text-xl font-bold">{pakket.klasse}</h3>
              <p class="text-brand/80 text-sm font-medium mt-1 mb-3">{pakket.sub}</p>
              <p class="text-gray-400 text-sm leading-relaxed mb-5">{pakket.omschrijving}</p>

              <div class="mt-auto">
                <div class="flex items-baseline gap-2">
                  {pakket.vanPrijs && <span class="text-gray-500 text-base line-through decoration-brand/60">{pakket.vanPrijs}</span>}
                  <span class="text-3xl font-black text-white leading-none">{pakket.prijs}</span>
                </div>
                <p class="text-gray-500 text-xs mt-1.5">
                  {pakket.abonnement ? `eenmalig + ${pakket.abonnement}` : 'eenmalig, incl. btw en montage'}
                </p>

                <div class="mt-5 flex flex-col gap-2.5">
                  {pakket.bestelLink ? (
                    <a href={pakket.bestelLink} target="_blank" rel="noopener" class="motion-button inline-flex items-center justify-center gap-2 bg-brand text-white rounded-full px-6 py-3.5 font-semibold hover:bg-white hover:text-black transition-all duration-300">
                      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                      Bestel &amp; betaal
                    </a>
                  ) : (
                    <a href="/contact/?dienst=alarmsystemen#formulier" class="motion-button inline-flex items-center justify-center gap-2 bg-brand text-white rounded-full px-6 py-3.5 font-semibold hover:bg-white hover:text-black transition-all duration-300">
                      Prijs aanvragen
                      <span>→</span>
                    </a>
                  )}
                  <a href="/alarmsystemen/" class="inline-flex items-center justify-center rounded-full border border-white/20 text-white px-6 py-3 font-semibold hover:border-brand hover:text-brand transition-colors">
                    Meer info
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Hoe het werkt -->
  <section class="py-20 md:py-24 bg-black">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="reveal max-w-2xl mb-14">
        <p class="text-brand font-medium tracking-widest uppercase mb-4">Hoe het werkt</p>
        <h2 class="heading-lg">In 3 stappen<br /><span class="text-gray-500">geregeld</span></h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6">
        {stappen.map((s, i) => (
          <div class="reveal rounded-2xl bg-gray-950 ring-1 ring-white/10 p-7">
            <span class="flex items-center justify-center w-11 h-11 rounded-xl bg-brand/15 text-brand font-black mb-5">{i + 1}</span>
            <h3 class="text-xl font-bold mb-2">{s.titel}</h3>
            <p class="text-gray-400 text-sm leading-relaxed">{s.tekst}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-24 md:py-32 bg-black overflow-hidden border-t border-white/10 reveal">
    <div class="absolute -top-40 right-[-10%] w-[45rem] h-[45rem] bg-brand/15 rounded-full blur-3xl" aria-hidden="true"></div>
    <div class="absolute -bottom-40 left-[-10%] w-[45rem] h-[45rem] bg-brand/10 rounded-full blur-3xl" aria-hidden="true"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-6 lg:px-8 text-center">
      <p class="text-brand font-medium tracking-widest uppercase mb-4">Hulp nodig?</p>
      <h2 class="heading-lg mb-6">Vragen voor u bestelt?</h2>
      <p class="text-lg text-gray-300 mb-10 max-w-2xl mx-auto">We helpen u graag met het kiezen van de juiste dienst voor uw voertuig.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-10">
        <a href="/contact/#formulier" class="motion-button group inline-flex items-center justify-center gap-3 bg-brand text-white rounded-full px-9 py-4 text-lg font-bold hover:bg-white hover:text-black transition-all duration-300">Stel uw vraag <span class="group-hover:translate-x-1 transition-transform duration-300">→</span></a>
      </div>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="tel:+31182796197" class="inline-flex items-center gap-2.5 rounded-full bg-white/5 ring-1 ring-white/10 px-5 py-3 text-gray-200 hover:ring-brand hover:text-white transition-all">
          <svg class="w-4 h-4 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
          (0182) 79 61 97
        </a>
        <a href="mailto:info@scharloo-install.nl" class="inline-flex items-center gap-2.5 rounded-full bg-white/5 ring-1 ring-white/10 px-5 py-3 text-gray-200 hover:ring-brand hover:text-white transition-all">
          <svg class="w-4 h-4 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
          info@scharloo-install.nl
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  const reveals = document.querySelectorAll('.reveal');
  const onScroll = () => reveals.forEach((el) => { if (el.getBoundingClientRect().top < window.innerHeight - 80) el.classList.add('active'); });
  window.addEventListener('scroll', onScroll);
  onScroll();
</script>
