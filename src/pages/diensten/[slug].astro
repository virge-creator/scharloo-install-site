---
import Layout from '../../layouts/Layout.astro';
import { diensten, type Dienst } from '../../data/diensten';

export function getStaticPaths() {
  return diensten
    .filter((d) => d.genereerPagina)
    .map((d) => ({ params: { slug: d.slug }, props: { dienst: d } }));
}

const { dienst } = Astro.props as { dienst: Dienst };
const heeftPrijs = dienst.prijzen.length > 0;
const eenPrijs = dienst.prijzen.length === 1;
const eerstePrijs = dienst.prijzen[0];
const heeftVarianten = !!(dienst.varianten && dienst.varianten.length > 0);
const extraFotos = dienst.afbeeldingen ? dienst.afbeeldingen.slice(1) : [];
const heeftExtraFotos = extraFotos.length > 0;
const bluEyePagina = `${dienst.slug} ${dienst.title} ${dienst.subtitle}`.toLowerCase().includes('blu eye');
const contactUrl = `/contact/?dienst=${encodeURIComponent(dienst.slug)}#formulier`;
// Houd de secties netjes afwisselend: met een varianten-blok ertussen
// wisselt de prijs-sectie mee van achtergrond.
const prijsBg = (heeftVarianten || heeftExtraFotos) ? 'bg-gray-950' : 'bg-black';
---

<Layout title={dienst.metaTitle} description={dienst.metaDesc}>
  <!-- Hero -->
  <section class="min-h-[60vh] bg-black text-white flex items-end pb-20 relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 w-full">
      <a href="/diensten/" class="inline-block text-gray-400 hover:text-white transition-colors text-sm mb-6 animate-fade-in-up">← Alle diensten</a>
      <p class="text-brand font-medium tracking-widest uppercase mb-4 animate-fade-in-up delay-100">Dienst</p>
      <h1 class="heading-xl animate-fade-in-up delay-100" style="opacity: 0;">
        {dienst.title}<br />
        <span class="text-gray-500">{dienst.subtitle}</span>
      </h1>
      <p class="text-xl text-gray-400 max-w-2xl mt-8 animate-fade-in-up delay-200" style="opacity: 0;">
        {dienst.intro}
      </p>

      {heeftPrijs && (
        <div class="mt-8 animate-fade-in-up delay-200" style="opacity: 0;">
          <span class="inline-flex flex-wrap items-center gap-x-3 gap-y-1 border border-gray-700 rounded-full pl-5 pr-6 py-2.5">
            <span class="text-gray-500 text-sm uppercase tracking-wide">vanaf</span>
            <span class="text-brand text-lg font-bold">{eerstePrijs.prijs}</span>
            {eerstePrijs.detail && <span class="text-gray-400 text-sm">{eerstePrijs.detail}</span>}
            {eerstePrijs.maand && (
              <>
                <span class="text-gray-600">+</span>
                <span class="text-brand text-lg font-bold">{eerstePrijs.maand}</span>
                <span class="text-gray-400 text-sm">{eerstePrijs.maandDetail}</span>
              </>
            )}
          </span>
        </div>
      )}
      <div class="mt-8 flex flex-col sm:flex-row gap-4 animate-fade-in-up delay-300" style="opacity: 0;">
        <a href={contactUrl} class="inline-flex items-center justify-center gap-3 rounded-full bg-brand px-7 py-4 font-semibold text-white transition-all duration-300 hover:bg-white hover:text-black">Vraag vrijblijvend advies <span>→</span></a>
        <a href="tel:+31182796197" class="inline-flex items-center justify-center rounded-full border border-gray-700 px-7 py-4 font-semibold text-white transition-colors hover:border-brand hover:text-brand">Bel (0182) 79 61 97</a>
      </div>
    </div>
  </section>

  <!-- Hoofdfoto (ingekaderd, niet schermvullend) -->
  {dienst.afbeelding && !bluEyePagina && (
    <section class="bg-black">
      <div class="max-w-6xl mx-auto px-6 lg:px-8 -mt-6 lg:-mt-10">
        <div class="reveal relative overflow-hidden rounded-2xl ring-1 ring-white/10">
          <img
            src={dienst.afbeelding}
            alt={dienst.afbeeldingAlt ?? dienst.title}
            class="w-full h-[34vh] min-h-[220px] max-h-[420px] object-cover"
            loading="lazy"
            onerror="this.closest('section').style.display='none'"
          />
        </div>
      </div>
    </section>
  )}

  {bluEyePagina && (
    <section class="bg-black pt-10 pb-16">
      <div class="max-w-6xl mx-auto px-6 lg:px-8">
        <div class="reveal mb-8 max-w-2xl">
          <p class="text-brand font-medium tracking-widest uppercase mb-4">Target Blu Eye 2</p>
          <h2 class="heading-lg">Het systeem<br /><span class="text-gray-500">in beeld</span></h2>
        </div>
        <div class="relative reveal mb-5">
          <div class="pointer-events-none absolute inset-0" style="background:radial-gradient(50% 60% at 50% 50%,rgba(22,129,222,.16),transparent 70%)"></div>
          <img src="/images/blu-eye-2-set-transparant.png" alt="Target Blu Eye 2 module en bediening" class="relative mx-auto max-h-64 md:max-h-72 w-auto object-contain" loading="lazy" />
        </div>
      </div>
    </section>
  )}

  {dienst.afbeeldingen && dienst.afbeeldingen.length > 0 && (
    <section class="bg-black pt-10 pb-14">
      <div class="max-w-6xl mx-auto px-6 lg:px-8">
        <div class="reveal mb-8 max-w-2xl">
          <p class="text-brand font-medium tracking-widest uppercase mb-4">In de praktijk</p>
          <h2 class="heading-lg">Bekijk het<br /><span class="text-gray-500">resultaat</span></h2>
        </div>
        {dienst.afbeeldingen[0].contain ? (
          <div class="reveal relative overflow-hidden rounded-2xl ring-1 ring-white/10 bg-gray-950">
            <div class="pointer-events-none absolute inset-0" style="background:radial-gradient(50% 60% at 50% 50%,rgba(22,129,222,.16),transparent 70%)"></div>
            <img src={dienst.afbeeldingen[0].src} alt={dienst.afbeeldingen[0].alt} class="relative mx-auto max-h-[46vh] w-auto object-contain p-8" loading="lazy" />
          </div>
        ) : (
          <div class="reveal overflow-hidden rounded-2xl ring-1 ring-white/10">
            <img src={dienst.afbeeldingen[0].src} alt={dienst.afbeeldingen[0].alt} class="w-full h-[40vh] min-h-[260px] max-h-[460px] object-cover" loading="lazy" />
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Wat we doen + voordelen -->
  <section class="py-24 bg-gray-950">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20">
        <div class="reveal">
          <p class="text-brand font-medium tracking-widest uppercase mb-4">Wat we doen</p>
          {dienst.over.map((alinea) => (
            <p class="text-lg text-gray-400 leading-relaxed mb-6">{alinea}</p>
          ))}
        </div>

        <div class="reveal">
          <p class="text-brand font-medium tracking-widest uppercase mb-4">Voordelen</p>
          <ul class="space-y-4">
            {dienst.voordelen.map((v) => (
              <li class="flex items-start gap-4 text-lg text-gray-300">
                <span class="text-brand text-2xl leading-none">✓</span>
                {v}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Meer beelden (verdeeld over de pagina) -->
  {heeftExtraFotos && (
    <section class="bg-black py-16">
      <div class="max-w-6xl mx-auto px-6 lg:px-8">
        <div class={`grid gap-4 ${extraFotos.length >= 3 ? 'md:grid-cols-3' : extraFotos.length === 2 ? 'md:grid-cols-2' : 'max-w-2xl mx-auto'}`}>
          {extraFotos.map((foto) => (
            foto.contain ? (
              <div class="reveal relative overflow-hidden rounded-2xl ring-1 ring-white/10 aspect-[4/3] bg-gray-950">
                <div class="pointer-events-none absolute inset-0" style="background:radial-gradient(55% 65% at 50% 50%,rgba(22,129,222,.16),transparent 70%)"></div>
                <img src={foto.src} alt={foto.alt} class="relative w-full h-full object-contain p-6" loading="lazy" />
              </div>
            ) : (
              <div class="reveal overflow-hidden rounded-2xl ring-1 ring-white/10 aspect-[4/3]">
                <img src={foto.src} alt={foto.alt} class="w-full h-full object-cover" loading="lazy" />
              </div>
            )
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Varianten / keuze-opties (alleen als ingesteld) -->
  {heeftVarianten && (
    <section class="py-24 bg-black">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="reveal mb-12">
          <p class="text-brand font-medium tracking-widest uppercase mb-4">Opties</p>
          <h2 class="heading-lg">{dienst.variantenTitel ?? 'Twee mogelijkheden'}</h2>
        </div>
        <div class="grid gap-6 md:grid-cols-2 max-w-4xl">
          {dienst.varianten.map((v) => (
            <div class="reveal motion-card relative overflow-hidden bg-gray-950 border border-gray-800 hover:border-brand transition-colors">
              <div class="absolute inset-x-0 top-0 h-1 bg-brand z-10"></div>
              {v.afbeelding && (
                <div class="aspect-[16/10] overflow-hidden border-b border-gray-800">
                  <img src={v.afbeelding} alt={v.afbeeldingAlt ?? v.naam} class="w-full h-full object-cover" loading="lazy" />
                </div>
              )}
              <div class="p-8">
                <h3 class="text-2xl font-bold mb-3">{v.naam}</h3>
                <p class="text-gray-400 leading-relaxed">{v.omschrijving}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Prijs / aanbod -->
  <section class={`py-24 ${prijsBg}`}>
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="reveal text-center max-w-2xl mx-auto mb-14">
        <p class="text-brand font-medium tracking-widest uppercase mb-4">Prijs</p>
        <h2 class="heading-lg">Wat kost het?</h2>
      </div>

      {eenPrijs || !heeftPrijs ? (
        <!-- Eén vaste prijs, of prijs op aanvraag: één strak aanbod-blok -->
        <div class="reveal motion-card max-w-xl mx-auto relative bg-gray-950 border border-gray-800">
          <div class="absolute inset-x-0 top-0 h-1 bg-brand"></div>
          <div class="p-10 lg:p-12 text-center">
            {heeftPrijs ? (
              <>
                {eerstePrijs.naam && (
                  <p class="text-gray-500 text-sm uppercase tracking-widest mb-8">{eerstePrijs.naam}</p>
                )}
                {eerstePrijs.maand ? (
                  <>
                    <div class="grid grid-cols-2 gap-6 max-w-sm mx-auto">
                      <div>
                        <p class="text-gray-500 text-xs uppercase tracking-widest mb-2">Eenmalig</p>
                        <div class="flex items-end justify-center gap-1.5">
                          <span class="text-gray-500 text-sm mb-1.5">vanaf</span>
                          <span class="text-4xl lg:text-5xl font-black text-white leading-none">{eerstePrijs.prijs}</span>
                        </div>
                        {eerstePrijs.detail && <p class="text-gray-500 text-xs mt-2">{eerstePrijs.detail}</p>}
                      </div>
                      <div class="border-l border-gray-800 pl-6">
                        <p class="text-gray-500 text-xs uppercase tracking-widest mb-2">Per maand</p>
                        <div class="flex items-end justify-center gap-1.5">
                          <span class="text-4xl lg:text-5xl font-black text-brand leading-none">{eerstePrijs.maand}</span>
                        </div>
                        {eerstePrijs.maandDetail && <p class="text-gray-500 text-xs mt-2">{eerstePrijs.maandDetail}</p>}
                      </div>
                    </div>
                    {eerstePrijs.maandOmschrijving && (
                      <p class="text-gray-400 text-sm mt-6 max-w-sm mx-auto leading-relaxed">{eerstePrijs.maandOmschrijving}</p>
                    )}
                  </>
                ) : (
                  <>
                    <div class="flex items-end justify-center gap-2">
                      <span class="text-gray-500 text-lg mb-2">vanaf</span>
                      <span class="text-6xl lg:text-7xl font-black text-white leading-none">{eerstePrijs.prijs}</span>
                    </div>
                    {eerstePrijs.detail && <p class="text-gray-400 mt-3">{eerstePrijs.detail}</p>}
                  </>
                )}
              </>
            ) : (
              <>
                <p class="text-3xl font-black text-white mb-3">Prijs op aanvraag</p>
                <p class="text-gray-400 max-w-sm mx-auto">
                  De prijs hangt af van uw voertuig(en) en wensen. Wij maken een passende, vrijblijvende offerte.
                </p>
              </>
            )}

            <div class="h-px bg-gray-800 my-8"></div>

            <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-3 text-left mb-10">
              {dienst.features.map((f) => (
                <li class="flex items-center gap-3 text-gray-300 text-sm">
                  <span class="text-brand flex-shrink-0">✓</span>
                  {f}
                </li>
              ))}
            </ul>

            <a
              href={contactUrl}
              class="inline-flex w-full sm:w-auto items-center justify-center gap-3 bg-brand text-white rounded-full px-10 py-4 font-semibold hover:bg-white hover:text-black transition-all duration-300"
            >
              Vraag een offerte aan
              <span>→</span>
            </a>
          </div>
        </div>
      ) : (
        <!-- Meerdere prijzen: nette rij kaarten -->
        <div>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 max-w-5xl mx-auto">
            {dienst.prijzen.map((p) => (
              <div class="reveal motion-card relative bg-gray-950 border border-gray-800 p-8 text-center">
                <div class="absolute inset-x-0 top-0 h-1 bg-brand"></div>
                <p class="text-gray-500 text-sm uppercase tracking-widest mb-4">{p.naam}</p>
                <div class="flex items-end justify-center gap-2">
                  <span class="text-gray-500 text-sm mb-1">vanaf</span>
                  <span class="text-4xl font-black text-white">{p.prijs}</span>
                </div>
                {p.detail && <p class="text-gray-400 text-sm mt-2">{p.detail}</p>}
              </div>
            ))}
          </div>
          <div class="text-center mt-10 reveal">
            <a
              href={contactUrl}
              class="inline-flex items-center justify-center gap-3 bg-brand text-white rounded-full px-10 py-4 font-semibold hover:bg-white hover:text-black transition-all duration-300"
            >
              Vraag een offerte aan
              <span>→</span>
            </a>
          </div>
        </div>
      )}

      {dienst.externLink && (
        <div class="reveal text-center mt-8">
          <a
            href={dienst.externLink.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 text-gray-400 hover:text-brand transition-colors font-medium"
          >
            {dienst.externLink.text}
            <span>→</span>
          </a>
        </div>
      )}
    </div>
  </section>

  <!-- CTA -->
  <section class="py-32 bg-brand text-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center reveal">
      <h2 class="heading-lg mb-8">
        Interesse in<br />{dienst.title}?
      </h2>
      <p class="text-xl text-white/80 mb-12 max-w-xl mx-auto">
        Neem contact op voor advies of een vrijblijvende offerte. We zijn inzetbaar door heel Nederland en België.
      </p>
      <a
        href={contactUrl}
        class="group inline-flex items-center gap-3 bg-white text-brand rounded-full px-10 py-5 text-xl font-bold hover:bg-black hover:text-white transition-all duration-300"
      >
        Contact opnemen
        <span class="group-hover:translate-x-2 transition-transform duration-300">→</span>
      </a>
      <div class="mt-12 text-white/80">
        <p class="text-lg"><a href="tel:+31182796197" class="hover:text-white transition-colors">📞 (0182) 79 61 97</a></p>
        <p class="text-lg"><a href="mailto:info@scharloo-install.nl" class="hover:text-white transition-colors">✉ info@scharloo-install.nl</a></p>
      </div>
    </div>
  </section>
</Layout>

<script>
  const reveals = document.querySelectorAll('.reveal');

  const revealOnScroll = () => {
    reveals.forEach((el) => {
      const top = el.getBoundingClientRect().top;
      if (top < window.innerHeight - 100) {
        el.classList.add('active');
      }
    });
  };

  window.addEventListener('scroll', revealOnScroll);
  revealOnScroll();
</script>
