---
// Verzekeraars-blok.
//  variant="full"    = klikbaar raster: bezoeker kiest zijn verzekeraar en krijgt een persoonlijke
//                      boodschap met knoppen voor een gratis verzekeraarcheck of direct bellen.
//  variant="compact" = rustige logobalk, voor onder een tekstblok.
// Logo's verschijnen automatisch als public/images/<slug>.png bestaat (of in de submap verzekeraars/).
// Logo's worden optisch even groot gemaakt: een breed logo wordt lager, een compact logo hoger.
import fs from 'node:fs';
import path from 'node:path';
import { verzekeraars } from '../data/verzekeraars';

interface Props {
  variant?: 'full' | 'compact';
}
const { variant = 'full' } = Astro.props;

// Zoekt het logo eerst in public/images/verzekeraars/, daarna gewoon in public/images/.
const mappen = ['images/verzekeraars', 'images'];
const logoVoor = (slug: string): string | null => {
  for (const m of mappen) {
    for (const ext of ['png', 'webp', 'svg']) {
      if (fs.existsSync(path.join(process.cwd(), 'public', m, `${slug}.${ext}`))) return `/${m}/${slug}.${ext}`;
    }
  }
  return null;
};
// Breedte/hoogte van een PNG uit de bestandskop lezen (geen extra pakket nodig).
const verhouding = (logo: string | null): number => {
  if (!logo || !logo.endsWith('.png')) return 3;
  try {
    const b = fs.readFileSync(path.join(process.cwd(), 'public', logo));
    return b.readUInt32BE(16) / b.readUInt32BE(20);
  } catch { return 3; }
};
// Optisch gelijk formaat: zelfde 'oppervlak', begrensd in hoogte en breedte.
const maat = (r: number, oppervlak: number, maxH: number, maxW: number) => {
  let h = Math.sqrt(oppervlak / r);
  h = Math.min(h, maxH, maxW / r);
  return { h: Math.round(h), w: Math.round(h * r) };
};
const lijst = verzekeraars.map((v) => {
  const logo = logoVoor(v.slug);
  const r = verhouding(logo);
  return { ...v, logo, groot: maat(r, 3400, 44, 190), klein: maat(r, 1300, 28, 92) };
});
const checkUrl = '/contact/?dienst=alarmsystemen&check=1#formulier';
---

{variant === 'full' ? (
  <div class="verz-kiezer" data-check-url={checkUrl}>
    <p class="text-sm font-semibold text-gray-400 mb-4">Bij wie bent u verzekerd? Klik op uw verzekeraar.</p>
    <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3" aria-label="Verzekeraars die SCM/CCV-gecertificeerde beveiliging accepteren">
      {lijst.map((v) => (
        <li>
          <button
            type="button"
            class="verz-tegel relative w-full flex items-center justify-center h-24 rounded-xl bg-white/[0.03] ring-1 ring-white/10 px-4 text-center transition-all hover:ring-brand/60 hover:bg-white/[0.06] aria-pressed:ring-2 aria-pressed:ring-brand aria-pressed:bg-brand/10"
            aria-pressed="false"
            data-naam={v.naam}
            data-slug={v.slug}
          >
            {v.partner && (
              <span class="absolute top-1.5 right-1.5 rounded-full bg-brand px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-white">Partner</span>
            )}
            <span class="flex flex-col items-center gap-1.5">
              <span class="h-11 w-full flex items-center justify-center">
                {v.logo ? (
                  <img src={v.logo} alt={`Logo ${v.naam}`} width={v.groot.w} height={v.groot.h} style={`height:${v.groot.h}px;width:auto`} class="verz-logo max-w-[85%] object-contain" loading="lazy" />
                ) : (
                  <span class="text-gray-200 font-semibold tracking-tight leading-tight">{v.naam}</span>
                )}
              </span>
              <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-400">
                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg>
                Geaccepteerd
              </span>
            </span>
          </button>
        </li>
      ))}
    </ul>

    <!-- Persoonlijke boodschap (verandert bij klikken; staat standaard op de algemene variant) -->
    <div class="verz-paneel mt-5 rounded-2xl bg-gradient-to-br from-brand/15 via-brand/[0.06] to-transparent ring-1 ring-brand/30 p-6 md:p-8" aria-live="polite">
      <div class="flex flex-col lg:flex-row lg:items-center gap-6 lg:gap-10">
        <div class="flex-1 min-w-0">
          <p class="flex items-center gap-2.5 text-xl md:text-2xl font-bold text-white mb-2">
            <span class="flex-none w-7 h-7 rounded-full bg-emerald-500/15 text-emerald-400 grid place-items-center"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg></span>
            <span class="verz-titel">Alle verzekeraars accepteren ons certificaat</span>
          </p>
          <p class="verz-tekst text-gray-300 leading-relaxed">Ons SCM/CCV-certificaat wordt geaccepteerd door alle Nederlandse autoverzekeraars, dus ook door die van u. Twijfelt u welke klasse uw verzekeraar voor uw auto eist? Dat zoeken wij gratis voor u uit.</p>
        </div>
        <div class="flex flex-col sm:flex-row lg:flex-col xl:flex-row gap-3 flex-none">
          <a href={checkUrl} class="verz-check motion-button inline-flex items-center justify-center gap-2 rounded-full bg-brand px-6 py-3.5 font-semibold text-white hover:bg-white hover:text-black transition-all duration-300">
            <span class="verz-check-label">Gratis klassecheck</span>
            <span>→</span>
          </a>
          <a href="tel:+31182796197" class="inline-flex items-center justify-center gap-2 rounded-full border border-white/20 px-6 py-3.5 font-semibold text-white hover:border-brand hover:text-brand transition-colors">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
            0182 796 197
          </a>
        </div>
      </div>
    </div>
  </div>
) : (
  <div class="flex flex-col lg:flex-row lg:items-center gap-5 lg:gap-8">
    <p class="flex-none text-xs font-semibold uppercase tracking-widest text-gray-500 lg:max-w-[9rem] leading-relaxed">Geaccepteerd door alle verzekeraars</p>
    <ul class="flex-1 grid grid-cols-4 sm:grid-cols-5 lg:grid-cols-10 items-center gap-x-5 gap-y-6" aria-label="Verzekeraars die SCM/CCV-gecertificeerde beveiliging accepteren">
      {lijst.map((v) => (
        <li class="flex items-center justify-center min-w-0">
          {v.logo ? (
            <img src={v.logo} alt={`Logo ${v.naam}`} width={v.klein.w} height={v.klein.h} style={`height:${v.klein.h}px;width:auto`} class="verz-logo verz-klein max-w-full object-contain" loading="lazy" />
          ) : (
            <span class="text-sm text-gray-300 font-medium">{v.naam}</span>
          )}
        </li>
      ))}
    </ul>
  </div>
)}

<style>
  /* Logo's in één rustige witte tint, zodat ze opgaan in de donkere site. */
  /* Logo's zijn al wit en transparant; de filter vangt een later toegevoegd gekleurd logo op. */
  .verz-logo { filter: brightness(0) invert(1); opacity: .85; transition: opacity .25s ease; }
  .verz-klein { opacity: .6; }
  .verz-klein:hover { opacity: 1; }
  .verz-tegel:hover .verz-logo, .verz-tegel[aria-pressed="true"] .verz-logo { opacity: 1; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.verz-kiezer').forEach((root) => {
    const basis = root.dataset.checkUrl || '/contact/#formulier';
    const titel = root.querySelector('.verz-titel');
    const tekst = root.querySelector('.verz-tekst');
    const check = root.querySelector<HTMLAnchorElement>('.verz-check');
    const label = root.querySelector('.verz-check-label');
    const paneel = root.querySelector<HTMLElement>('.verz-paneel');
    root.querySelectorAll<HTMLButtonElement>('.verz-tegel').forEach((knop) => {
      knop.addEventListener('click', () => {
        const naam = knop.dataset.naam || '';
        root.querySelectorAll('.verz-tegel').forEach((k) => k.setAttribute('aria-pressed', 'false'));
        knop.setAttribute('aria-pressed', 'true');
        if (titel) titel.textContent = `Ja, ${naam} accepteert ons certificaat`;
        if (tekst) tekst.textContent = `Ons SCM/CCV-certificaat voldoet aan de eisen van ${naam}. Na de inbouw stuurt u het certificaat naar ${naam} en uw auto is goed verzekerd. Twijfelt u welke klasse ${naam} voor uw auto eist? Wij zoeken het gratis voor u uit.`;
        if (label) label.textContent = `Gratis klassecheck`;
        if (check) {
          const [pad, hash] = basis.split('#');
          check.href = `${pad}&verzekeraar=${encodeURIComponent(naam)}${hash ? '#' + hash : ''}`;
        }
        if (paneel && paneel.getBoundingClientRect().top > window.innerHeight - 120) {
          paneel.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    });
  });
</script>
